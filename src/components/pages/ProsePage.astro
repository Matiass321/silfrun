---
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import { date, type Locale } from '~/config/site';
import { t } from '~/i18n';
import { path } from '~/i18n/routes';
import { CONTENT, LEGAL_UPDATED, type ProsePage } from '~/data/content';

interface Props {
  locale: Locale;
  /** Heading shown as the h1 and as the final breadcrumb. */
  heading: string;
  eyebrow: string;
  page: ProsePage;
  /** Legal pages carry a draft notice and a last-reviewed date. */
  legal?: boolean;
  /** Suppress the closing call to action on pages where it would jar. */
  cta?: boolean;
}

const { locale, heading, eyebrow, page, legal = false, cta = true } = Astro.props;
const s = t(locale);
const c = CONTENT[locale];
---

<article>
  <header class="section section--tight">
    <div class="wrap wrap--narrow">
      <Breadcrumbs locale={locale} trail={[{ label: heading }]} />
      <p class="eyebrow">{eyebrow}</p>
      <h1 class="page__title">{heading}</h1>
      <div class="silfrun-rule page__rule"></div>
      <p class="lead">{page.lead}</p>

      {legal && (
        <div class="draft">
          <p class="draft__date">{c.legalUpdatedLabel}: {date(LEGAL_UPDATED, locale)}</p>
          <p class="draft__note">{c.legalDraftNotice}</p>
        </div>
      )}
    </div>
  </header>

  <section class="section section--tight">
    <div class="wrap wrap--narrow sections">
      {page.sections.map((sec) => (
        <section class="block">
          <h2>{sec.heading}</h2>
          {sec.paragraphs.map((p) => <p>{p}</p>)}
          {sec.points && (
            <ul class="ticks">
              {sec.points.map((pt) => <li>{pt}</li>)}
            </ul>
          )}
        </section>
      ))}
    </div>
  </section>

  {cta && (
    <section class="section section--deep">
      <div class="wrap wrap--narrow stack stack--24">
        <h2 class="final__title">{s.finalCta.title}</h2>
        <p class="lead">{s.finalCta.body}</p>
        <p class="final__action"><a class="btn btn--foil btn--lg" href={path('quote', locale)}>{s.finalCta.cta}</a></p>
      </div>
    </section>
  )}
</article>

<style>
  .page__title { max-width: 20ch; }
  .page__rule { max-width: 7rem; margin-block: var(--space-300); }

  /**
   * The draft notice is a caution plate, not an alert box: aged brass on a
   * barely-tinted ground, with the signal carried by a 1px edge rather than a
   * fill. It must read as a standing condition, not as an error.
   */
  .draft {
    display: flex;
    flex-direction: column;
    gap: var(--space-100);
    margin-block-start: var(--space-400);
    padding: var(--space-300);
    background: var(--signal-caution-surface);
    border: 1px solid transparent;
    border-inline-start: 1px solid var(--signal-caution);
    border-radius: var(--radius-sm);
  }

  .draft__date {
    font: var(--type-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--signal-caution);
  }

  .draft__note { font-size: var(--text-sm); color: var(--text-secondary); }

  .sections { display: flex; flex-direction: column; gap: var(--space-1000); }

  .block { display: flex; flex-direction: column; gap: var(--space-300); }
  .block h2 { font-size: var(--display-md); max-width: 24ch; }
  .block p { color: var(--text-secondary); font-size: var(--text-lg); line-height: var(--leading-loose); }

  .final__title { max-width: 16ch; }
  .final__action { margin-block-start: var(--space-200); }
</style>
