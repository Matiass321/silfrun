---
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import { type Locale } from '~/config/site';
import { t } from '~/i18n';
import { path, SERVICE_KEYS, type ServiceKey } from '~/i18n/routes';
import { SERVICE_CONTENT } from '~/data/services';

interface Props {
  locale: Locale;
  service: ServiceKey;
}

const { locale, service } = Astro.props;
const s = t(locale);
const c = SERVICE_CONTENT[locale][service];

const others = SERVICE_KEYS.filter((k) => k !== service);

/**
 * FAQPage structured data is emitted only because every answer on this page is
 * genuinely written. If a service ever gains a placeholder answer, filter for
 * it here rather than marking up a non-answer as an answer.
 */
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />

<article>
  <header class="section section--tight">
    <div class="wrap wrap--narrow">
      <Breadcrumbs
        locale={locale}
        trail={[{ label: s.nav.services, href: path('services', locale) }, { label: s.services[service].name }]}
      />
      <p class="eyebrow">{s.services.eyebrow}</p>
      <h1 class="page__title">{s.services[service].name}</h1>
      <div class="silfrun-rule page__rule"></div>
      <p class="lead">{c.lead}</p>
    </div>
  </header>

  <section class="section section--tight">
    <div class="wrap wrap--narrow prose">
      {c.body.map((para) => <p>{para}</p>)}
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap wrap--narrow stack stack--32">
      <div class="stack stack--16">
        <h2>{c.includedTitle}</h2>
        <ul class="ticks">
          {c.included.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div class="stack stack--16">
        <h2>{c.materialTitle}</h2>
        <dl class="defs">
          {c.material.map((m) => (
            <div class="def">
              <dt>{m.name}</dt>
              <dd>{m.note}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap wrap--narrow stack stack--16">
      <h2>{c.expectTitle}</h2>
      <ul class="plain">
        {c.expect.map((e) => <li>{e}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap wrap--narrow stack stack--16">
      <h2>{locale === 'is' ? 'Algengar spurningar' : 'Common questions'}</h2>
      <div class="faqs">
        {c.faqs.map((f) => (
          <details class="faq">
            <summary class="faq__q">{f.q}</summary>
            <p class="faq__a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap wrap--narrow stack stack--16">
      <h2>{locale === 'is' ? 'Önnur þjónusta' : 'Other services'}</h2>
      <ul class="chips">
        {others.map((k) => (
          <li><a class="chip" href={path(k, locale)}>{s.services[k].name}</a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--deep">
    <div class="wrap wrap--narrow stack stack--24">
      <h2 class="final__title">{s.finalCta.title}</h2>
      <p class="lead">{s.finalCta.body}</p>
      <p class="final__action"><a class="btn btn--foil btn--lg" href={path('quote', locale)}>{s.finalCta.cta}</a></p>
    </div>
  </section>
</article>

<style>
  .page__title { max-width: 18ch; }
  .page__rule { max-width: 7rem; margin-block: var(--space-300); }

  .prose { display: flex; flex-direction: column; gap: var(--space-300); }
  .prose p { color: var(--text-secondary); font-size: var(--text-lg); line-height: var(--leading-loose); }

  .plain { display: flex; flex-direction: column; gap: var(--space-300); }
  .plain li { color: var(--text-secondary); max-width: var(--measure-body); }

  .chips { display: flex; flex-wrap: wrap; gap: var(--space-150); }

  .final__title { max-width: 16ch; }
  .final__action { margin-block-start: var(--space-200); }
</style>
