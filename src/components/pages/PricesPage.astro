---
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Pending from '~/components/Pending.astro';
import { SITE, money, type Locale } from '~/config/site';
import { t } from '~/i18n';
import { path } from '~/i18n/routes';

interface Props { locale: Locale }

const { locale } = Astro.props;
const s = t(locale);
const p = s.prices;
const { items, minimumCallout } = SITE.pricing;

type ItemKey = keyof typeof p.items;

/**
 * A price line, or a clearly marked pending value.
 *
 * An unset amount is never rendered as a number and never guessed at — it
 * shows as a placeholder, exactly like an unfilled phone number, so a figure
 * the business has not agreed to cannot reach a customer.
 */
const rows = items.map((item) => ({
  key: item.key as ItemKey,
  label: p.items[item.key as ItemKey],
  amount: item.from,
  unit: item.unit,
  minQty: item.minQty,
}));

const pendingLabel = locale === 'is' ? 'verð væntanlegt' : 'price pending';

/**
 * Offer structured data is emitted only for lines with a real price. While
 * every amount is null, no Offer markup is emitted at all rather than
 * publishing a priceless offer.
 */
const priced = rows.filter((r) => r.amount !== null);

const offersLd =
  priced.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'OfferCatalog',
        name: p.title,
        itemListElement: priced.map((r) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: r.label },
          price: r.amount,
          priceCurrency: SITE.pricing.currency,
        })),
      }
    : null;
---

{offersLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(offersLd)} />}

<article>
  <header class="section section--tight">
    <div class="wrap wrap--narrow">
      <Breadcrumbs locale={locale} trail={[{ label: p.title.replace('.', '') }]} />
      <p class="eyebrow">{p.eyebrow}</p>
      <h1 class="page__title">{p.title}</h1>
      <div class="silfrun-rule page__rule"></div>
      <p class="lead">{p.lead}</p>
    </div>
  </header>

  <section class="section section--tight">
    <div class="wrap wrap--narrow stack stack--24">
      <ul class="rates">
        {rows.map((r) => (
          <li class="rate">
            <div class="rate__label">
              <span>{r.label}</span>
              {r.minQty && <span class="rate__note">{p.minQty.replace('{n}', String(r.minQty))}</span>}
            </div>
            <div class="rate__value">
              {r.amount === null ? (
                <Pending label={pendingLabel} locale={locale} nowrap />
              ) : (
                <>
                  <span class="rate__from">{p.fromLabel}</span>
                  <span class="rate__amount">{money(r.amount, locale)}</span>
                  {r.unit === 'm2' && <span class="rate__note">{p.perM2}</span>}
                </>
              )}
            </div>
          </li>
        ))}
      </ul>

      <p class="vat">{p.vatNote}</p>
    </div>
  </section>

  <section class="section section--sunk">
    <div class="wrap wrap--narrow stack stack--16">
      <h2>{p.minimumTitle}</h2>
      <p class="muted">{p.minimumBody}</p>
      <p class="minimum">
        {minimumCallout === null
          ? <Pending label={pendingLabel} locale={locale} nowrap />
          : money(minimumCallout, locale)}
      </p>
    </div>
  </section>

  <section class="section section--deep">
    <div class="wrap wrap--narrow stack stack--24">
      <h2 class="final__title">{s.finalCta.title}</h2>
      <p class="lead">{s.finalCta.body}</p>
      <p class="final__action"><a class="btn btn--foil btn--lg" href={path('quote', locale)}>{p.cta}</a></p>
    </div>
  </section>
</article>

<style>
  .page__title { max-width: 18ch; }
  .page__rule { max-width: 7rem; margin-block: var(--space-300); }

  /**
   * The rate list is a ruled ledger, not a table of cards. Each line is a
   * hairline-separated row with the label left and the figure right, so the
   * numerals form a single vertical column the eye can run down.
   */
  .rates { display: flex; flex-direction: column; border-block-start: 1px solid var(--edge-quiet); }

  .rate {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-150) var(--space-400);
    padding-block: var(--space-300);
    border-block-end: 1px solid var(--edge-quiet);
  }

  .rate__label { display: flex; flex-direction: column; gap: var(--space-050); }
  .rate__label > span:first-child { font-size: var(--text-lg); color: var(--text-primary); }

  .rate__value {
    display: flex;
    align-items: baseline;
    gap: var(--space-150);
    font-variant-numeric: tabular-nums;
  }

  /* "from" is a qualifier, not part of the figure — mono, quiet, small. */
  .rate__from {
    font: var(--type-mono);
    font-size: 10.5px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--silver-500);
  }

  /* The figure is Marcellus. A price is the most looked-at number on the site. */
  .rate__amount {
    font-family: var(--font-display);
    font-size: var(--display-sm);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    color: var(--text-primary);
    line-height: 1;
  }

  .rate__note { font: var(--type-mono); font-size: 10.5px; color: var(--text-muted); }

  .vat { font: var(--type-mono); color: var(--text-muted); max-width: 60ch; }

  .muted { color: var(--text-secondary); }

  /* The minimum is the one figure allowed to be set at display scale. */
  .minimum {
    font-family: var(--font-display);
    font-size: var(--display-lg);
    font-weight: var(--weight-display);
    letter-spacing: var(--tracking-display);
    font-variant-numeric: tabular-nums;
    color: var(--text-primary);
    line-height: 1;
  }

  .final__title { max-width: 16ch; }
  .final__action { margin-block-start: var(--space-200); }
</style>
