---
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Pending from '~/components/Pending.astro';
import { type Locale } from '~/config/site';
import { t } from '~/i18n';
import { path } from '~/i18n/routes';
import { CONTENT } from '~/data/content';

interface Props { locale: Locale }

const { locale } = Astro.props;
const s = t(locale);
const groups = CONTENT[locale].faq;

const heading = locale === 'is' ? 'Algengar spurningar' : 'Frequently asked questions';
const lead =
  locale === 'is'
    ? 'Svör byggð á því hvernig efni hegða sér, ekki á loforðum. Þar sem svarið ræðst af verklagi sem enn hefur ekki verið ákveðið segjum við það frekar en að finna upp svar.'
    : 'Answers grounded in how materials actually behave, not in promises. Where an answer depends on policy that has not been set, we say so rather than inventing one.';

/**
 * FAQPage structured data covers only the questions with a real answer.
 *
 * Marking up a pending placeholder as an accepted answer would publish a
 * non-answer to search engines, so unanswered questions are filtered out
 * entirely — and if nothing is answered, no markup is emitted at all.
 */
const answered = groups.flatMap((g) => g.items).filter((i) => i.a !== null);

const faqLd =
  answered.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: answered.map((i) => ({
          '@type': 'Question',
          name: i.q,
          acceptedAnswer: { '@type': 'Answer', text: i.a },
        })),
      }
    : null;

const pendingLabel = locale === 'is' ? 'Svar væntanlegt' : 'Answer pending';
---

{faqLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />}

<article>
  <header class="section section--tight">
    <div class="wrap wrap--narrow">
      <Breadcrumbs locale={locale} trail={[{ label: heading }]} />
      <p class="eyebrow">{heading}</p>
      <h1>{heading}</h1>
      <p class="lead">{lead}</p>
    </div>
  </header>

  {groups.map((group, gi) => (
    <section class:list={['section', 'section--tight', { 'section--sunk': gi % 2 === 1 }]}>
      <div class="wrap wrap--narrow stack stack--16">
        <h2>{group.heading}</h2>
        <div class="faqs">
          {group.items.map((item) => (
            <details class="faq">
              <summary class="faq__q">{item.q}</summary>
              {item.a === null
                ? <p class="faq__a"><Pending label={pendingLabel} locale={locale} /></p>
                : <p class="faq__a">{item.a}</p>}
            </details>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section section--deep">
    <div class="wrap wrap--narrow stack stack--24">
      <h2>{s.finalCta.title}</h2>
      <p class="lead">{s.finalCta.body}</p>
      <p><a class="btn btn--primary" href={path('quote', locale)}>{s.finalCta.cta}</a></p>
    </div>
  </section>
</article>

<style>
  .faqs { display: flex; flex-direction: column; }

  .faq { border-block-end: 1px solid var(--line); }

  .faq__q {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-16);
    padding-block: var(--space-16);
    font-weight: var(--weight-semi);
    cursor: pointer;
    list-style: none;
  }

  .faq__q::-webkit-details-marker { display: none; }

  .faq__q::after {
    content: '+';
    color: var(--accent);
    font-size: var(--step-1);
    line-height: 1;
    flex-shrink: 0;
  }

  .faq[open] .faq__q::after { content: '\2212'; }

  .faq__a {
    padding-block-end: var(--space-24);
    color: var(--muted);
    font-size: var(--step--1);
  }
</style>
