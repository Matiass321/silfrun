---
import Logo from './Logo.astro';
import { LOCALES, type Locale } from '~/config/site';
import { t } from '~/i18n';
import { path, type PageKey } from '~/i18n/routes';

interface Props {
  locale: Locale;
  /** Which page this is, so the language switch lands on its translation
      rather than dumping the visitor on the homepage. */
  pageKey: PageKey;
}

const { locale, pageKey } = Astro.props;
const s = t(locale);

const links: { key: PageKey; label: string }[] = [
  { key: 'services', label: s.nav.services },
  { key: 'prices',   label: s.nav.prices },
  { key: 'process',  label: s.nav.process },
  { key: 'results',  label: s.nav.work },
  { key: 'areas',    label: s.nav.areas },
  { key: 'about',    label: s.nav.about },
];

const others = LOCALES.filter((l) => l !== locale);
const LABEL: Record<Locale, string> = { is: 'IS', en: 'EN' };
---

<header class="head">
  <div class="wrap head__inner">
    <a class="head__brand" href={path('home', locale)} aria-label={`${s.nav.skip}`}>
      <Logo />
    </a>

    <nav class="head__nav" aria-label={s.nav.menu}>
      <ul class="head__list">
        {links.map((l) => (
          <li><a class="head__link" href={path(l.key, locale)}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="head__end">
      <ul class="head__langs" aria-label={s.nav.language}>
        {others.map((l) => (
          <li>
            <a class="head__lang" href={path(pageKey, l)} lang={l}>
              {LABEL[l]}
            </a>
          </li>
        ))}
      </ul>
      <a class="btn btn--primary head__cta" href={path('quote', locale)}>{s.nav.quote}</a>
    </div>
  </div>
</header>

<style>
  .head {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .head__inner {
    display: flex;
    align-items: center;
    gap: var(--space-32);
    min-height: 4.5rem;
  }

  .head__brand { text-decoration: none; flex-shrink: 0; }

  .head__nav { margin-inline-start: auto; }

  .head__list {
    display: flex;
    align-items: center;
    gap: var(--space-24);
  }

  .head__link {
    font-size: var(--step--1);
    font-weight: var(--weight-medium);
    letter-spacing: 0.02em;
    color: var(--ink-soft);
    text-decoration: none;
    padding-block: var(--space-8);
    border-bottom: 1px solid transparent;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .head__link:hover { color: var(--accent); border-color: var(--accent-line); }

  .head__end {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    flex-shrink: 0;
  }

  .head__langs { display: flex; gap: var(--space-8); }

  .head__lang {
    font-size: var(--step--1);
    font-weight: var(--weight-semi);
    letter-spacing: 0.08em;
    color: var(--muted);
    text-decoration: none;
    padding: var(--space-4) var(--space-8);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }

  .head__lang:hover { color: var(--accent); border-color: var(--accent-line); }

  .head__cta { padding: 0.6em 1.2em; font-size: var(--step--1); }

  /* The nav collapses to the CTA on small screens. A hamburger for five links
     costs more than it saves; the links all live in the footer as well. */
  @media (max-width: 60rem) {
    .head__nav { display: none; }
    .head__end { margin-inline-start: auto; }
  }

  @media (max-width: 26rem) {
    .head__langs { display: none; }
  }
</style>
