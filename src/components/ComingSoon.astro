---
import { SITE, whatsappUrl, isPlaceholder } from '~/config/site';
import { mediaUrl, altFor, type MediaRow } from '~/lib/media';

interface Props {
  hero?: MediaRow;
  heroMobile?: MediaRow;
  /** 'ok' | 'bad' | 'err' — the result of a signup, read back from the URL. */
  status?: string | null;
}

const { hero, heroMobile, status } = Astro.props;

const wa = whatsappUrl('Halló Silfrun. Hvenær opnið þið?');
const phone = isPlaceholder(SITE.contact.phone) ? null : SITE.contact.phone;
const email = isPlaceholder(SITE.contact.email) ? null : SITE.contact.email;

const both = hero && heroMobile;
const only = hero ?? heroMobile;
const alt = altFor(only, 'is');
---

<div class="cs">
  {/*
    A split, not an overlay.

    Text laid over a photograph either needs a scrim — which dulls the one
    asset the page has — or it fights whatever happens to be behind it. Here
    the copy has its own ground and the photograph is left completely alone:
    no gradient, no wash, no grain. It also means the sofa stays the subject
    instead of being something the headline sits on top of.
  */}
  <div class="cs__pane">
    <header class="cs__brand" style="--i: 0">
      <svg class="cs__mark" viewBox="0 0 48 64" fill="none" aria-hidden="true">
        <path d="M24 2 Q16 17 6 32 Q16 47 24 62 Z" fill="currentColor" opacity=".14" />
        <path d="M24 2 Q32 17 42 32 Q32 47 24 62 Q16 47 6 32 Q16 17 24 2 Z"
              stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
      </svg>
      <span class="cs__word">{SITE.brand}</span>
    </header>

    <main class="cs__main">
      <p class="cs__eyebrow" style="--i: 1">Opnum fljótlega</p>

      <h1 class="cs__title" style="--i: 2">Sófar og teppi,<br />hreinsuð heima.</h1>

      <p class="cs__lead" style="--i: 3">
        Sérhæfð hreinsun á höfuðborgarsvæðinu.
      </p>

      {/* One line, one field. Everything the page had to say is above it. */}
      <form class="cs__form" method="POST" action="/api/subscribe" id="join" style="--i: 4">
        <input type="hidden" name="locale" value="is" />

        <label class="cs__label" for="cs-email">
          Skildu eftir netfang og við látum vita þegar við opnum.
        </label>

        <div class="cs__row">
          <input
            class="cs__input"
            id="cs-email"
            type="email"
            name="email"
            inputmode="email"
            autocomplete="email"
            placeholder="netfang"
            required
          />
          <button class="cs__go" type="submit" aria-label="Láta mig vita">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 12h15M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6"
                    stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>

        {status === 'ok' && <p class="cs__msg cs__msg--ok" role="status">Takk. Við sendum línu þegar við opnum.</p>}
        {status === 'bad' && <p class="cs__msg cs__msg--bad" role="status">Netfangið leit ekki rétt út.</p>}
        {status === 'err' && <p class="cs__msg cs__msg--bad" role="status">Eitthvað fór úrskeiðis. Reyndu aftur.</p>}
      </form>
    </main>

    <footer class="cs__foot" style="--i: 5">
      {(wa || phone) && (
        <p class="cs__now">
          {wa && <a class="cs__link" href={wa} target="_blank" rel="noopener nofollow">WhatsApp</a>}
          {wa && phone && <span class="cs__dot" aria-hidden="true">·</span>}
          {phone && <a class="cs__link" href={`tel:${SITE.contact.phoneE164}`}>{phone}</a>}
          {email && <span class="cs__dot" aria-hidden="true">·</span>}
          {/*
            email_off stops Cloudflare rewriting the address into a
            [email protected] placeholder. That rewrite relies on a decoder
            script to put the address back, and this site sends
            script-src 'none' — so the placeholder was permanent and the link
            was dead for every visitor.
          */}
          {email && (
            <Fragment set:html={`<!--email_off--><a class="cs__link" href="mailto:${email}">${email}</a><!--/email_off-->`} />
          )}
        </p>
      )}

      <p class="cs__legal">{SITE.legalName} · kt. {SITE.kennitala}</p>
    </footer>
  </div>

  {only && (
    <div class="cs__shot">
      {both ? (
        <picture>
          <source media="(min-width: 60rem)" srcset={mediaUrl(heroMobile!.key)} />
          <img src={mediaUrl(hero!.key)} alt={alt} fetchpriority="high" decoding="async" />
        </picture>
      ) : (
        <img src={mediaUrl(only.key)} alt={alt} fetchpriority="high" decoding="async" />
      )}
    </div>
  )}
</div>

<style>
  /**
   * Phone: the photograph on top, the copy under it on its own ground.
   * Desktop: two columns, copy left, photograph right, full height.
   */
  .cs {
    min-height: 100svh;
    display: flex;
    flex-direction: column-reverse;
    background: var(--surface-page);
  }

  /* The page is one screen. Anything that cannot fit scrolls inside the copy
     column rather than pushing the photograph off the bottom of the window. */
  @media (min-width: 60rem) {
    .cs { height: 100svh; overflow: hidden; }
    .cs__pane { overflow-y: auto; }
  }

  /**
   * 34svh, so the field clears the fold.
   *
   * At 42svh the strip pushed the whole page to 990px on an 844px screen and
   * the one thing the page is for — the email field — sat below the fold. The
   * photograph is establishing the business, not carrying the page; it can
   * give up the height.
   */
  .cs__shot { position: relative; height: 32svh; overflow: hidden; }
  .cs__shot :global(picture) { display: block; width: 100%; height: 100%; }

  .cs__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
    display: block;
  }

  .cs__pane {
    display: flex;
    flex-direction: column;
    gap: var(--space-400);
    padding: var(--space-500) var(--space-400) var(--space-300);
    flex: 1;
  }

  /* ---- brand ---- */

  .cs__brand { display: flex; align-items: center; gap: var(--space-200); }
  .cs__mark { width: 18px; height: 24px; color: var(--text-secondary); flex: none; }

  .cs__word {
    font-family: var(--font-display);
    font-size: 15px;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  /* ---- copy ---- */

  .cs__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-300);
    margin-block: auto;
  }

  .cs__eyebrow {
    font: var(--type-mono);
    font-size: 10.5px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /**
   * Sized to the column it lives in, not to the window.
   *
   * 9vw is a full-width measurement, and this headline sits in a 33rem pane —
   * at 1440 it resolved to 68px in a 432px measure, so "Sófar og teppi," broke
   * mid-phrase and the manual break after it produced four ragged lines
   * instead of the two the line was written as.
   */
  .cs__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 3.25rem);
    line-height: 1.04;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    text-wrap: balance;
  }

  .cs__lead {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 30ch;
  }

  /* ---- the field ----
   *
   * A rule, not a box. Two grey rectangles side by side is the shape of every
   * newsletter form on the internet; a single underlined line with the action
   * sitting on the end of it reads as one gesture.
   */

  .cs__form { display: flex; flex-direction: column; gap: var(--space-200); margin-block-start: var(--space-300); }

  .cs__label { font-size: var(--text-sm); color: var(--text-muted); max-width: 34ch; }

  .cs__row {
    display: flex;
    align-items: center;
    gap: var(--space-200);
    max-width: 26rem;
    border-block-end: 1px solid var(--edge-control);
    transition: border-color var(--dur-base) var(--ease-glide);
  }

  .cs__row:focus-within { border-block-end-color: var(--text-primary); }

  .cs__input {
    flex: 1;
    min-width: 0;
    height: 3.25rem;
    padding: 0;
    background: none;
    border: 0;
    color: var(--text-primary);
    /* 16px floor: below it iOS zooms the viewport when the field takes focus. */
    font-size: var(--text-md);
    font-family: inherit;
  }

  .cs__input::placeholder { color: var(--text-muted); }
  .cs__input:focus { outline: none; }

  .cs__go {
    flex: none;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--edge-control);
    border-radius: 50%;
    background: none;
    color: var(--text-primary);
    cursor: pointer;
    transition: background var(--dur-base) var(--ease-glide),
                border-color var(--dur-base) var(--ease-glide),
                transform var(--dur-base) var(--ease-glide);
  }

  .cs__go svg { width: 18px; height: 18px; }

  .cs__go:hover {
    background: var(--text-primary);
    border-color: var(--text-primary);
    color: var(--surface-page);
    transform: translateX(2px);
  }

  .cs__go:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: 3px; }

  .cs__msg { font-size: var(--text-sm); }
  .cs__msg--ok { color: var(--signal-positive); }
  .cs__msg--bad { color: var(--signal-negative); }

  /* ---- foot ---- */

  .cs__foot { display: flex; flex-direction: column; gap: var(--space-150); }

  .cs__now { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-150); font-size: var(--text-sm); }
  .cs__dot { color: var(--text-muted); }

  .cs__link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-glide);
  }

  .cs__link:hover { color: var(--text-primary); }

  .cs__legal {
    font: var(--type-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  /* ---- desktop ---- */

  @media (min-width: 60rem) {
    .cs { flex-direction: row; }

    .cs__pane {
      flex: 0 0 auto;
      width: min(44%, 33rem);
      gap: var(--space-600);
      padding: var(--space-700, var(--space-600)) var(--space-600);
      justify-content: space-between;
    }

    .cs__shot { flex: 1; height: auto; }

    /* The portrait frame is nearly square once it fills this column, and the
       subject sits low in it — centring the crop lands on the wall above the
       sofa, which reads as an empty black panel. */
    .cs__shot img { object-position: 50% 68%; }
  }

  /**
   * A short, staggered settle on load.
   *
   * Six elements, 70ms apart, 12px of travel. Enough to feel considered and
   * not enough to make anybody wait — the whole sequence is over in under
   * half a second, and nothing moves that the visitor might be reaching for.
   */
  @media (prefers-reduced-motion: no-preference) {
    .cs__brand,
    .cs__eyebrow,
    .cs__title,
    .cs__lead,
    .cs__form,
    .cs__foot {
      animation: cs-in 620ms cubic-bezier(.22, .61, .36, 1) both;
      animation-delay: calc(var(--i, 0) * 70ms);
    }

    .cs__shot { animation: cs-fade 900ms cubic-bezier(.22, .61, .36, 1) both; }
  }

  @keyframes cs-in {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: none; }
  }

  @keyframes cs-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
</style>
