---
import Logo from './Logo.astro';
import Pending from './Pending.astro';
import { SITE, isPlaceholder, type Locale } from '~/config/site';
import { t } from '~/i18n';
import { path, SERVICE_KEYS } from '~/i18n/routes';

interface Props { locale: Locale }
const { locale } = Astro.props;
const s = t(locale);

/**
 * The year is stamped at build time. A site rebuilt each deploy shows the
 * right year; a hardcoded one silently goes stale every January.
 */
const year = new Date().getFullYear();

const serviceLinks = SERVICE_KEYS.map((k) => ({ href: path(k, locale), label: s.services[k].name }));

const companyLinks = [
  { href: path('about', locale),   label: s.nav.about },
  { href: path('process', locale), label: s.nav.process },
  { href: path('results', locale), label: s.nav.work },
  { href: path('areas', locale),   label: s.nav.areas },
  { href: path('faq', locale),     label: locale === 'is' ? 'Algengar spurningar' : 'FAQ' },
  { href: path('contact', locale), label: s.nav.contact },
];

const legalLinks = [
  { href: path('privacy', locale), label: locale === 'is' ? 'Persónuvernd' : 'Privacy' },
  { href: path('terms', locale),   label: locale === 'is' ? 'Skilmálar' : 'Terms' },
];
---

<footer class="foot">
  <div class="wrap foot__inner">
    <div class="foot__brand">
      <Logo tagline={s.footer.tagline} />
    </div>

    <nav class="foot__col" aria-label={s.footer.servicesHeading}>
      <h2 class="foot__heading">{s.footer.servicesHeading}</h2>
      <ul class="foot__list">
        {serviceLinks.map((l) => <li><a class="foot__link" href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <nav class="foot__col" aria-label={s.footer.companyHeading}>
      <h2 class="foot__heading">{s.footer.companyHeading}</h2>
      <ul class="foot__list">
        {companyLinks.map((l) => <li><a class="foot__link" href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="foot__col">
      <h2 class="foot__heading">{s.nav.contact}</h2>
      <ul class="foot__list">
        <li class="foot__meta">
          <span class="foot__key">{s.common.phone}</span>
          {isPlaceholder(SITE.contact.phone)
            ? <Pending label={s.pending.phone} locale={locale} nowrap />
            : <a class="foot__link" href={`tel:${SITE.contact.phoneE164}`}>{SITE.contact.phone}</a>}
        </li>
        <li class="foot__meta">
          <span class="foot__key">{s.common.email}</span>
          {isPlaceholder(SITE.contact.email)
            ? <Pending label={s.pending.email} locale={locale} />
            : <a class="foot__link" href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>}
        </li>
        <li class="foot__meta">
          <span class="foot__key">{s.common.hours}</span>
          <span class="foot__hours">{s.common.weekdays} {SITE.hours[0].opens}–{SITE.hours[0].closes}</span>
        </li>
      </ul>
      <nav class="foot__legal" aria-label={s.footer.legalHeading}>
        <ul class="foot__list foot__list--inline">
          {legalLinks.map((l) => <li><a class="foot__link" href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </div>

  <div class="wrap">
    <div class="foot__base">
      <p class="foot__fine">
        © {year} {isPlaceholder(SITE.legalName)
          ? <Pending label={s.pending.legalName} locale={locale} />
          : SITE.legalName}. {s.footer.rights}
      </p>
      <p class="foot__fine">
        {s.footer.kennitalaLabel}{' '}
        {isPlaceholder(SITE.kennitala)
          ? <Pending label={s.pending.kennitala} locale={locale} nowrap />
          : SITE.kennitala}
      </p>
    </div>
  </div>
</footer>

<style>
  /**
   * The footer carries the plate treatment — inked on light, deepest on dark —
   * foil hairline across the top edge. It is the inside of the case the silver
   * is returned to.
   */
  .foot {
    position: relative;
    background: var(--foot-surface);
    color: var(--plate-text-secondary);

    /* Same reason as .section--deep: the footer ground is dark in both
       themes, so the page tokens are redefined rather than patched. */
    --text-primary: var(--plate-text);
    --text-secondary: var(--plate-text-secondary);
    --text-muted: var(--plate-muted);
    --text-accent: var(--plate-accent);
    --text-link: var(--plate-accent);
    --edge-hairline: var(--plate-edge);
    --edge-control: var(--plate-edge-control);
    --edge-focus: var(--plate-edge-focus);
    --edge-strong: rgba(226, 232, 238, .28);
    --accent: var(--plate-accent);
    /* Derived tokens, remapped by name — see the note in tokens.css. */
    --btn-hero-bg: var(--plate-foil-soft);
    --btn-hero-ink: var(--basalt-900);
    --btn-hero-edge: var(--sheen-vellum);
    --foil-silver-text: var(--plate-foil-text);
    --foil-hairline: var(--plate-hairline);
    --signal-positive: var(--plate-signal-positive);
    --signal-positive-surface: var(--plate-signal-positive-surface);
    --signal-caution: var(--plate-signal-caution);
    --signal-caution-surface: var(--plate-signal-caution-surface);
    --signal-negative: var(--plate-signal-negative);
    --signal-negative-surface: var(--plate-signal-negative-surface);
    --focus-ring: var(--plate-focus-ring);
    padding-block: var(--space-1200) var(--space-500);
    margin-block-start: auto;
    isolation: isolate;
  }

  .foot::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--plate-edge);
  }

  .foot::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: var(--grain-url);
    background-size: var(--grain-size);
    opacity: var(--plate-grain-opacity);
    pointer-events: none;
    z-index: -1;
  }

  .foot__inner {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: var(--space-800) var(--space-500);
    align-items: start;
  }

  .foot__brand { display: flex; flex-direction: column; gap: var(--space-300); font-size: 19px; }
  .foot__brand :global(.sf-logo__tagline) { max-width: 24ch; }

  .foot__col { display: flex; flex-direction: column; gap: var(--space-300); }

  .foot__heading {
    font: var(--type-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--plate-text-secondary);
    margin: 0;
    padding-block-end: var(--space-150);
    border-block-end: 1px solid var(--edge-quiet);
  }

  .foot__list { display: flex; flex-direction: column; gap: var(--space-025); }
  .foot__list--inline { flex-direction: row; flex-wrap: wrap; gap: var(--space-200); }

  /**
   * Tap targets.
   *
   * The header nav is hidden below 64rem, so on a phone the footer IS the
   * site's navigation — and these links were 15px boxes. WCAG 2.5.8 asks for
   * 24px; a thumb wants more. The row gap comes off as the link grows, so the
   * visual pitch of the list moves very little.
   *
   * Growing the box is safe here only because the hover state is a colour
   * change and nothing else. Where a link carries a rule or an underline the
   * box has to stay put and the target is grown with a pseudo-element instead
   * — which is what --head__lang and the logo do.
   */
  .foot__link {
    display: flex;
    align-items: center;
    min-height: 2.25rem;
    font-size: var(--text-sm);
    color: var(--plate-text-secondary);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-glide);
  }

  @media (min-width: 48rem) {
    .foot__list { gap: var(--space-050); }
    .foot__link { min-height: 1.75rem; }
  }

  .foot__link:hover { color: var(--plate-text); }

  .foot__meta { display: flex; flex-direction: column; gap: var(--space-025); font-size: var(--text-sm); }

  /* The label is mono because it is a specification, not prose. */
  .foot__key {
    font: var(--type-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .foot__hours { color: var(--plate-text-secondary); font-variant-numeric: tabular-nums; }

  .foot__legal { margin-block-start: var(--space-200); }

  .foot__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-100) var(--space-400);
    margin-block-start: var(--space-1000);
    padding-block-start: var(--space-400);
    border-block-start: 1px solid var(--edge-quiet);
  }

  .foot__fine {
    font: var(--type-mono);
    font-size: 11px;
    letter-spacing: 0;
    color: var(--text-muted);
    max-width: none;
  }

  @media (max-width: 64rem) {
    .foot__inner { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 34rem) {
    .foot__inner { grid-template-columns: 1fr; gap: var(--space-600); }
    .foot { padding-block-start: var(--space-800); }
  }
</style>
