---
import '@fontsource-variable/archivo';
import '@fontsource/ibm-plex-mono/400.css';
import '~/styles/admin.css';

import { SITE } from '~/config/site';
import { ADMIN_ICONS } from '~/data/admin-icons';

interface Props {
  title: string;
  current?: 'today' | 'visits' | 'calendar' | 'media' | 'people' | 'stats';
  /** Chrome-less shell, for login and setup. */
  bare?: boolean;
}

const { title, current, bare = false } = Astro.props;

/**
 * Five tabs, because six is where a phone tab bar starts truncating labels.
 *
 * Settings is deliberately not one of them — it is opened a handful of times
 * ever, and spending a fifth of the thumb bar on it would cost a tab that gets
 * used every day. It lives in the top bar instead.
 */
const TABS = [
  { key: 'today',    href: '/admin/',          label: 'Today',    icon: ADMIN_ICONS.today },
  { key: 'visits',   href: '/admin/visits/',   label: 'Jobs',     icon: ADMIN_ICONS.visits },
  { key: 'calendar', href: '/admin/calendar/', label: 'Calendar', icon: ADMIN_ICONS.calendar },
  { key: 'media',    href: '/admin/media/',    label: 'Photos',   icon: ADMIN_ICONS.image },
  { key: 'stats',    href: '/admin/stats/',    label: 'Stats',    icon: ADMIN_ICONS.stats },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {/*
      viewport-fit=cover lets the tab bar sit against the bottom of the screen
      on a notched phone, with env(safe-area-inset-bottom) keeping it clear of
      the home indicator.
    */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{title} · {SITE.brand}</title>

    {/*
      Never indexed. robots.txt disallows /admin/, but a Disallow only asks a
      crawler not to fetch — it does nothing about a URL that leaked into a
      link. The header and this tag are what actually remove it.
    */}
    <meta name="robots" content="noindex, nofollow, noarchive" />

    {/* Installable to the home screen; see public/admin.webmanifest. */}
    <link rel="manifest" href="/admin.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={SITE.brand} />
    <link rel="apple-touch-icon" href="/admin-icon-180.png" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>

  <body class="adm">
    {/*
      Rendered only with the chrome. login and setup pass `bare` and have no
      nav at all, where a skip link would just be a dead first tab stop.
    */}
    {!bare && <a class="a-skip" href="#a-main">Skip to content</a>}

    {!bare && (
      <header class="a-top">
        <div class="a-top__in">
          <a class="a-brand" href="/admin/">
            <svg viewBox="0 0 48 64" fill="none" aria-hidden="true">
              <path d="M24 2 Q16 17 6 32 Q16 47 24 62 Z" fill="currentColor" opacity=".12" />
              <path d="M24 2 Q32 17 42 32 Q32 47 24 62 Q16 47 6 32 Q16 17 24 2 Z"
                    stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            </svg>
            <span>{SITE.brand}</span>
          </a>

          <nav class="a-tabs" aria-label="Main menu">
            {TABS.map((t) => (
              <a
                class="a-tab"
                href={t.href}
                aria-current={t.key === current ? 'page' : undefined}
              >
                <span set:html={t.icon} />
                <span>{t.label}</span>
              </a>
            ))}
          </nav>

          <div class="a-out">
            <a class="a-btn a-btn--quiet a-btn--sm" href="/admin/settings/" aria-label="Settings">
              <span set:html={ADMIN_ICONS.settings} />
            </a>
          </div>
        </div>
      </header>
    )}

    {/* tabindex=-1 because Safari will not move focus to a non-focusable
        element on fragment navigation, so the skip link would do nothing. */}
    <main id="a-main" tabindex="-1" class:list={['a-main', { 'a-main--bare': bare }]}>
      <slot />
    </main>
  </body>
</html>
