---
/**
 * Marcellus speaks, Archivo works, Plex Mono annotates. Self-hosted rather than
 * pulled from a CDN so the page still makes zero external requests. Both text
 * faces cover Icelandic — ÁÐÉÍÓÚÝÞÆÖ.
 */
import '@fontsource/marcellus/400.css';
import '@fontsource-variable/archivo';
import '@fontsource/ibm-plex-mono/400.css';
import '~/styles/tokens.css';
import '~/styles/base.css';

import { SITE, isPlaceholder, type Locale } from '~/config/site';
import { t } from '~/i18n';
import { PAGE_META } from '~/i18n/meta';
import type { Alternate } from '~/i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonical: string;
  alternates: Alternate[];
  xDefault: string;
  /** Emit LocalBusiness structured data. Only the homepage needs it. */
  business?: boolean;
  /** Page-specific structured data, emitted alongside the site-wide graph. */
  jsonLd?: object | object[];
  /** Override the social share image. Defaults to the brand card. */
  ogImage?: string;
  /**
   * Keep this page out of search. For pages that exist for one visitor at one
   * moment — a confirmation carrying a reference number has no business in
   * anybody's search results.
   */
  noindex?: boolean;
}

const {
  locale, title, description, canonical, alternates, xDefault,
  business = false, jsonLd: pageLd, ogImage, noindex = false,
} = Astro.props;
const s = t(locale);

const fullTitle = `${title} · ${SITE.brand}`;

/** BCP 47 tags. Schema.org and og:locale both want the full tag, not "is". */
const LOCALE_TAGS: Record<Locale, string> = { is: 'is-IS', en: 'en-GB' };

/** The same page in the other language, for translationOfWork. */
const translations = alternates.filter((a) => a.locale !== locale).map((a) => a.href);

/**
 * LocalBusiness structured data, assembled from real values only.
 *
 * Every field is omitted rather than filled with a placeholder — publishing
 * "[Símanúmer væntanlegt]" as a telephone number in machine-readable markup is
 * worse than publishing no telephone number at all.
 */
const hoursSpec = SITE.hours.map((h) => ({
  '@type': 'OpeningHoursSpecification',
  dayOfWeek: h.days.map((d) => ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][d]),
  opens: h.opens,
  closes: h.closes,
}));

/** Profiles the business actually has. A placeholder is never emitted. */
const sameAs = Object.values(SITE.social).filter((v) => !isPlaceholder(v)) as string[];

/**
 * No priceRange.
 *
 * The business does not publish figures any more, and priceRange in
 * structured data is a published figure — a "27.000–48.000 ISK" band in the
 * local panel is exactly the number the site has decided not to state. An
 * omitted field says nothing; a guessed "$" would be invented.
 */

/** Absolute URL for the social card. Cloudflare serves it from the site root. */
const ogImageUrl = new URL(ogImage ?? '/og.png', SITE.url).href;

/**
 * The business node is emitted on EVERY page, not just the home page.
 *
 * Service nodes carry provider: {'@id': '…/#business'} and Offers carry
 * availableAtOrFrom pointing at the same id. With the node present on only two
 * of forty-four pages, those references dangled everywhere else — a graph that
 * points at nothing is worse than one that says less, because a validator
 * reads it as a broken entity rather than an absent one.
 *
 * `business` now only decides whether the page claims the entity as its
 * primary subject via WebPage.about, which is still the home page alone.
 */
const businessLd = {
      '@context': 'https://schema.org',
      '@type': ['LocalBusiness', 'HomeAndConstructionBusiness'],
      '@id': `${SITE.url}/#business`,
      name: SITE.brand,
      alternateName: SITE.brandAscii,
      url: `${SITE.url}/`,
      description,
      image: ogImageUrl,
      logo: new URL('/favicon.svg', SITE.url).href,
      knowsLanguage: ['is', 'en'],
      currenciesAccepted: SITE.pricing.currency,
      areaServed: SITE.areas.map((a) => ({
        '@type': 'City',
        name: a.name,
        containedInPlace: { '@type': 'Country', name: 'Iceland' },
      })),
      /**
       * The street is emitted only when the address is marked public.
       *
       * This is a service-area business — the work happens in the customer's
       * home. Putting the registered address in structured data is what makes
       * it appear in Google's local panel with a pin on it, which is precisely
       * what "do not advertise the location" rules out.
       *
       * The locality still goes out, because a cleaning company that names no
       * region at all is harder to place than one that says "capital area".
       */
      address: {
        '@type': 'PostalAddress',
        /* When the address is withheld, the locality is omitted rather than
           replaced. It previously hardcoded 'Reykjavík' while site.ts records
           Mosfellsbær, publishing a city the business is not in as
           machine-readable fact. areaServed carries the geography instead —
           that is what it is for on a service-area business. */
        ...(SITE.address.public ? { addressLocality: SITE.address.city } : {}),
        addressCountry: SITE.address.country,
        ...(SITE.address.public && !isPlaceholder(SITE.address.street)
          ? { streetAddress: SITE.address.street } : {}),
        ...(SITE.address.public && !isPlaceholder(SITE.address.postalCode)
          ? { postalCode: SITE.address.postalCode } : {}),
      },
      openingHoursSpecification: hoursSpec,
      ...(sameAs.length ? { sameAs } : {}),
      ...(isPlaceholder(SITE.contact.phoneE164) ? {} : { telephone: SITE.contact.phoneE164 }),
      ...(isPlaceholder(SITE.contact.email) ? {} : { email: SITE.contact.email }),
      ...(isPlaceholder(SITE.legalName) ? {} : { legalName: SITE.legalName }),
      ...(isPlaceholder(SITE.kennitala) ? {} : { taxID: SITE.kennitala }),
      ...(SITE.address.public && SITE.address.latitude !== null && SITE.address.longitude !== null
        ? { geo: { '@type': 'GeoCoordinates', latitude: SITE.address.latitude, longitude: SITE.address.longitude } }
        : {}),
  /**
   * No aggregateRating until genuine reviews exist. Self-serving review
   * markup is both a manual-action risk and a lie.
   */
};

/**
 * The WebSite node describes the SITE, so it must be identical on every page.
 *
 * It previously took the current page's description and locale, which meant
 * one @id was published forty-four different ways — the English sofa page
 * described the whole site as "Hot-water extraction cleaning for sofas", and
 * inLanguage flipped between is-IS and en-GB depending on which page a crawler
 * happened to fetch first.
 */
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: `${SITE.url}/`,
  name: SITE.brand,
  description: PAGE_META[SITE.defaultLocale].home.description,
  inLanguage: ['is-IS', 'en-GB'],
  publisher: { '@id': `${SITE.url}/#business` },
};

/**
 * The page itself, tied to the site and the business.
 *
 * An answer engine deciding whether to quote a page wants to know what kind of
 * page it is, who stands behind it and when it was last touched. Naming the
 * primary language and the translation explicitly also keeps the two locales
 * from being read as duplicates of one another.
 */
const webPageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#page`,
  url: canonical,
  name: fullTitle,
  description,
  inLanguage: LOCALE_TAGS[locale],
  isPartOf: { '@id': `${SITE.url}/#website` },
  ...(business ? { about: { '@id': `${SITE.url}/#business` } } : {}),
  ...(translations.length ? { translationOfWork: translations } : {}),
  primaryImageOfPage: ogImageUrl,
};

/** Page-supplied schema, normalised to an array so a page may pass either. */
const extraLd = pageLd ? (Array.isArray(pageLd) ? pageLd : [pageLd]) : [];

const graph = [websiteLd, webPageLd, businessLd, ...extraLd];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}

    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'is' ? 'is_IS' : 'en_GB'} />
    {alternates
      .filter((a) => a.locale !== locale)
      .map((a) => (
        <meta property="og:locale:alternate" content={a.locale === 'is' ? 'is_IS' : 'en_GB'} />
      ))}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={`${SITE.brand} — ${title}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`${SITE.brand} — ${title}`} />

    {/*
      Told explicitly rather than left to be guessed: a bilingual site whose
      two languages use genuinely different slugs is easy to misread as one
      language with duplicate pages.
    */}
    <meta name="author" content={SITE.brand} />
    <meta http-equiv="content-language" content={LOCALE_TAGS[locale]} />

    {/*
      Let the big engines show a full snippet and a large thumbnail. Without
      this, Google may truncate to a two-line summary, which is the difference
      between being quoted in an AI answer and being skipped.
    */}
    <meta
      name="robots"
      content={noindex
        ? 'noindex, nofollow'
        : 'max-snippet:-1, max-image-preview:large, max-video-preview:-1'}
    />

    {/* Base-aware: a hardcoded "/favicon.svg" 404s on a subpath deploy. */}
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    {/*
      Both themes are declared, so the browser paints form controls,
      scrollbars and the address bar to match the one actually in use. With
      only "dark" here a visitor on a light OS got dark scrollbars against a
      paper page.

      Two theme-color tags rather than one: the media attribute is how the
      address bar follows the theme rather than being pinned to whichever
      value was hardcoded.
    */}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0B0D0F" />

    {/* One graph per page: fewer blocks, and the @id references resolve. */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
  </head>

  <body class="silfrun-grain">
    <a class="skip-link" href="#main">{s.nav.skip}</a>
    <slot />

    {/*
      Page-view beacon.
      
      Prerendered pages are served from the edge and never reach the Worker, so
      there is nothing to count them by server-side. This 35-byte pixel is the
      smallest request that does, and unlike a script it works with JavaScript
      disabled — which is most of the point on a site that ships none.

      Last in the body so it never competes with content for the connection.
      Nothing identifying is recorded; see src/lib/analytics.ts.

      Deliberately NOT loading="lazy". A lazy image is only fetched once it
      nears the viewport, and on pages several thousand pixels tall that meant
      a view was counted only for visitors who scrolled all the way down.
      fetchpriority="low" yields to real content without deferring the request
      out of existence.
    */}
    {!noindex && (
      <img
        src={`/px.gif?p=${encodeURIComponent(new URL(canonical).pathname)}`}
        alt=""
        width="1"
        height="1"
        fetchpriority="low"
        decoding="async"
        aria-hidden="true"
        style="position:absolute;width:1px;height:1px;opacity:0;pointer-events:none"
      />
    )}
  </body>
</html>
