---
import Marketing from '~/layouts/Marketing.astro';
import ClosingCta from '~/components/ClosingCta.astro';
import HeroMedia from '~/components/HeroMedia.astro';
import MediaSlot from '~/components/MediaSlot.astro';
import BeforeAfter from '~/components/BeforeAfter.astro';

import { LOCALES, SITE, trackedUrl, type Locale } from '~/config/site';
import { t, alternates } from '~/i18n';
import { path, areaPath } from '~/i18n/routes';
import { slotMap, bySlot, galleryPairs, type MediaRow } from '~/lib/media';
import { env } from '~/lib/admin-guard';
import { HOME, STEPS, FIELDS } from '~/data/homepage';

/**
 * Rendered per request, not at build.
 *
 * This page reads the media library, and a prerendered page reads it once — at
 * deploy time — so a photograph uploaded in the admin was invisible until
 * somebody redeployed. The HTML is edge-cached instead, so the cost of the
 * change is a D1 read on a cache miss rather than on every hit.
 */
export const prerender = false;

const langParam = String(Astro.params.lang ?? '');
if (!(LOCALES as readonly string[]).includes(langParam)) {
  return new Response(null, { status: 404 });
}
const locale = langParam as Locale;

const s = t(locale);
const c = HOME[locale];
const alt = alternates('home', locale);

let media: Record<string, MediaRow | undefined> = {};
let proof: MediaRow[] = [];
{
  const { DB } = env(Astro);
  if (DB) {
    try {
      [media, proof] = await Promise.all([
        slotMap(DB, ['hero', 'hero-mobile', 'sofa', 'rug', 'carpet', 'stains']),
        bySlot(DB, 'gallery'),
      ]);
    } catch { /* every slot falls back to its marked plate */ }
  }
}

/* Two at a time reads as a comparison; a grid of six reads as stock. */
const pairs = galleryPairs(proof).slice(0, 2);

const wa = trackedUrl('whatsapp', {
  from: `/${locale}/`,
  text: locale === 'is'
    ? 'Halló Silfrun. Ég sendi mynd — hverju má ég búast við?'
    : 'Hello Silfrun. Sending a photo — what should I expect?',
});

Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=86400'
);
---

<Marketing
  locale={locale}
  pageKey="home"
  title={s.meta.home.title}
  description={s.meta.home.description}
  canonical={alt.canonical}
  alternates={alt.list}
  xDefault={alt.xDefault}
  prefill={s.contact.prefillGeneral}
  business
>
  <div class="home">
    {/* ══ 1 · Hero ═══════════════════════════════════════════════════ */}
    <section class="hero">
      <div class="hero__media">
        <HeroMedia locale={locale} desktop={media['hero']} mobile={media['hero-mobile']} scrim="none" />
      </div>

      <div class="wrap hero__inner">
        <h1 class="hero__title">{c.heroTitle}</h1>
        <p class="hero__lead">{c.heroLead}</p>

        <div class="hero__acts">
          <a class="btn btn--foil btn--lg" href={path('quote', locale)}>{c.heroPrimary}</a>
          {wa && (
            <a class="btn btn--ghost btn--lg" href={wa} target="_blank" rel="noopener nofollow">
              {c.heroSecondary}
            </a>
          )}
        </div>
      </div>

    </section>

    {/* ══ 2 · Proof ══════════════════════════════════════════════════ */}
    <section class="section s-proof">
      <div class="wrap">
        <h2 class="only reveal">{c.proofTitle}</h2>

<ul class="grid grid--2">
          {(pairs.length ? pairs : [{}, {}]).map((pair, i) => (
            <li class="reveal">
              <BeforeAfter
                locale={locale}
                before={pair.before}
                after={pair.after}
                ratio="4 / 3"
                priority={i === 0}
                label={locale === 'is'
                  ? 'Áður · sama ljós og sjónarhorn'
                  : 'Before · same light and angle'}
              />
            </li>
          ))}
        </ul>

        <p class="reveal"><a class="link-arrow" href={path('results', locale)}>{c.proofCta}</a></p>
      </div>
    </section>

    {/* ══ 3 · What we clean ══════════════════════════════════════════ */}
    <section class="section section--sunk s-fields">
      <div class="wrap">
        <h2 class="only reveal">{c.fieldsTitle}</h2>

        <ul class="grid grid--4">
          {FIELDS.map((f) => (
            <li class="reveal">
              <a class="field" href={path(f.key, locale)}>
                <MediaSlot
                  slot={f.slot}
                  locale={locale}
                  media={media[f.slot]}
                  ratio="4 / 5"
                  label={s.services[f.key].name}
                  class="field__shot"
                />
                <span class="field__name">{s.services[f.key].name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ══ 6 · How it works ═══════════════════════════════════════════ */}
    <section class="section section--sunk s-steps">
      <div class="wrap">
        <h2 class="only reveal">{c.stepsTitle}</h2>

        <ol class="grid grid--4">
          {STEPS.map((st) => (
            <li class="steps__item reveal">
              <p class="steps__n" aria-hidden="true">{st.n}</p>
              <h3 class="steps__title">{st.title[locale]}</h3>
              <p class="steps__body">{st.body[locale]}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ══ 7 · Areas ══════════════════════════════════════════════════ */}
    <section class="section section--tight s-areas">
      <div class="wrap">
        <h2 class="only reveal">{c.areasTitle}</h2>

        <ul class="chips reveal">
          {SITE.areas.map((area) => (
            <li><a class="chip" href={areaPath(area.slug, locale)}>{area.name}</a></li>
          ))}
        </ul>

        <p class="reveal"><a class="link-arrow" href={path('areas', locale)}>{c.areasCta}</a></p>
      </div>
    </section>

    {/* ══ 8 · Close ══════════════════════════════════════════════════ */}
    <div class="s-close">
      <ClosingCta locale={locale} prefill={s.contact.prefillGeneral} />
    </div>
  </div>
</Marketing>

<style>
  .home { display: flex; flex-direction: column; }

  /**
   * A heading standing on its own.
   *
   * Most sections used to carry an eyebrow, a heading AND a lead paragraph.
   * Three pieces of furniture to introduce four photographs reads as a
   * brochure; if a heading needs a paragraph under it to explain itself, it is
   * the wrong heading. Only the one section making an argument keeps a lead.
   */
  .only { margin-block-end: var(--space-500); }

  /* ------------------------------------------------------------------ *
   * Scroll reveal — CSS only, so the site still ships no JavaScript.
   * 14px over 700ms: enough to register as movement, not enough to look
   * like a template. Absent entirely where either is unsupported.
   * ------------------------------------------------------------------ */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .reveal {
        animation: reveal linear both;
        animation-timeline: view();
        animation-range: entry 8% cover 26%;
      }

      @keyframes reveal {
        from { opacity: 0; transform: translateY(14px); }
        to   { opacity: 1; transform: none; }
      }
    }
  }

  /* ------------------------------------------------------------------ *
   * Hero
   * ------------------------------------------------------------------ */
  /**
   * The hero runs to the top of the screen and fills it.
   *
   * Pulled up by the header's own height so the photograph starts behind the
   * bar rather than below it — the bar is transparent up there, so the image
   * is the first thing and the whole thing.
   *
   * svh, not vh: on a phone vh is the height with the browser chrome hidden,
   * so a 100vh hero is cut off by the address bar on load and only fits once
   * the visitor scrolls. svh is the smallest state, which is the one that has
   * to fit.
   */
  .hero {
    position: relative;
    margin-block-start: calc(var(--head-h) * -1);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero__inner > * {
    text-shadow: 0 1px 2px rgba(7, 8, 10, .45), 0 2px 28px rgba(7, 8, 10, .35);
  }

  /* Buttons paint their own ground, so they neither need it nor want it. */
  .hero__inner .btn { text-shadow: none; }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-300);
    min-height: 100svh;
    padding-block: calc(var(--head-h) + var(--space-600)) calc(var(--sticky-h) + var(--space-500));
    justify-content: flex-end;
  }

  .hero__eyebrow { color: var(--text-accent); }

  .hero__title {
    font-family: var(--font-display);
    font-size: var(--display-xl, clamp(2.5rem, 7vw, 4.75rem));
    line-height: 1.03;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    max-width: 15ch;
    text-wrap: balance;
    margin: 0;
  }

  .hero__lead { font-size: var(--text-lg); color: var(--text-secondary); }

  .hero__acts { display: flex; flex-wrap: wrap; gap: var(--space-200); }

  /* Below 26rem two pills side by side are two cramped pills.
     align-self is the load-bearing line: .hero__inner is a flex column with
     align-items: flex-start, so without it the row shrinks to its content and
     the buttons dutifully fill 166px of the available 342. */
  @media (max-width: 26rem) {
    .hero__acts {
      align-self: stretch;
      flex-direction: column;
      align-items: stretch;
    }

    .hero__acts > * { justify-content: center; }
  }

  /* ---- three assurances ---- */

  /* ------------------------------------------------------------------ *
   * One grid for every row of four on the page — photographs, service
   * cards and steps all sit on the same rhythm rather than each inventing
   * their own.
   * ------------------------------------------------------------------ */
  .grid { display: grid; gap: var(--space-400); margin-block-end: var(--space-500); }

  /* ---- service cards: a photograph and a name, nothing else ---- */

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-200);
    text-decoration: none;
    color: inherit;
  }

  .field__shot { overflow: hidden; border-radius: var(--radius-sm); }

  .field__shot :global(img),
  .field__shot :global(video) {
    transition: transform var(--dur-slow, 640ms) var(--ease-glide);
  }

  .field:hover .field__shot :global(img),
  .field:hover .field__shot :global(video) { transform: scale(1.03); }

  .field__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--text-primary);
  }

  /* ------------------------------------------------------------------ *
   * Care — the one section still making an argument, so the one that
   * keeps a lead paragraph.
   * ------------------------------------------------------------------ */
  /* ------------------------------------------------------------------ *
   * Limits — three lines, no explanation under each.
   * ------------------------------------------------------------------ */

  /* ------------------------------------------------------------------ *
   * Areas
   *
   * .chip is the system's token for this and lives in base.css; only the
   * container and a thumb-sized height belong here. 40px rather than the
   * default 32: six of these sit side by side and wrap, so on a phone the
   * gap between two adjacent targets matters as much as either one.
   * ------------------------------------------------------------------ */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-150);
    margin-block-end: var(--space-400);
  }

  .chips .chip { height: 40px; padding-inline: var(--space-250); }

  @media (min-width: 48rem) {
    .chips .chip { height: 34px; }
  }

  /* ------------------------------------------------------------------ *
   * Steps
   * ------------------------------------------------------------------ */
  .steps__item {
    padding-block-start: var(--space-300);
    border-block-start: 1px solid var(--edge-quiet);
  }

  .steps__n {
    font: var(--type-mono);
    font-size: 12px;
    letter-spacing: var(--tracking-label);
    color: var(--text-accent);
    margin-block-end: var(--space-200);
  }

  .steps__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--text-primary);
    margin: 0 0 var(--space-075);
  }

  .steps__body { font-size: var(--text-sm); color: var(--text-muted); }

  /* ------------------------------------------------------------------ *
   * Wide screens
   * ------------------------------------------------------------------ */
  @media (min-width: 48rem) {
    .grid--4 { grid-template-columns: repeat(2, 1fr); }
    .grid--2 { grid-template-columns: repeat(2, 1fr); }
    .limits { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-400); }
  }

  @media (min-width: 64rem) {
    .hero__inner { padding-block: var(--space-1000) var(--space-800); }
    .grid--4 { grid-template-columns: repeat(4, 1fr); }
    .care { grid-template-columns: 1fr minmax(0, 22rem); gap: var(--space-800); }
  }
</style>
