---
import Marketing from '~/layouts/Marketing.astro';
import ClosingCta from '~/components/ClosingCta.astro';
import HeroMedia from '~/components/HeroMedia.astro';
import MediaSlot from '~/components/MediaSlot.astro';
import StainRegister from '~/components/home/StainRegister.astro';

import { LOCALES, SITE, trackedUrl, type Locale } from '~/config/site';
import { t, alternates } from '~/i18n';
import { path, areaPath } from '~/i18n/routes';
import { slotMap, bySlot, type MediaRow } from '~/lib/media';
import { env } from '~/lib/admin-guard';
import { REFUSALS } from '~/data/home';
import { HOME, STEPS, ASSURANCES, FIELDS } from '~/data/homepage';

/**
 * Rendered per request, not at build.
 *
 * This page reads the media library, and a prerendered page reads it once — at
 * deploy time — so a photograph uploaded in the admin was invisible until
 * somebody redeployed the site. The whole point of having an upload screen is
 * that it works without one. The HTML is cached at the edge instead, so the
 * cost of the change is a D1 read on a cache miss rather than on every hit.
 */
export const prerender = false;

const langParam = String(Astro.params.lang ?? '');
if (!(LOCALES as readonly string[]).includes(langParam)) {
  return new Response(null, { status: 404 });
}
const locale = langParam as Locale;

const s = t(locale);
const c = HOME[locale];
const alt = alternates('home', locale);

let media: Record<string, MediaRow | undefined> = {};
let proof: MediaRow[] = [];
{
  const { DB } = env(Astro);
  if (DB) {
    try {
      [media, proof] = await Promise.all([
        slotMap(DB, ['hero', 'hero-mobile', 'home-fibre', 'sofa', 'rug', 'carpet', 'stains']),
        bySlot(DB, 'gallery'),
      ]);
    } catch { /* every slot falls back to its marked plate */ }
  }
}

/* Two at a time reads as a comparison; three reads as a grid of stock. */
const pairs = proof.slice(0, 4);

const wa = trackedUrl('whatsapp', {
  from: `/${locale}/`,
  text: locale === 'is'
    ? 'Halló Silfrun. Ég sendi mynd — hverju má ég búast við?'
    : 'Hello Silfrun. Sending a photo — what should I expect?',
});

/**
 * Edge-cached HTML.
 *
 * s-maxage puts the rendered page in Cloudflare's cache so the common request
 * never reaches the worker, and stale-while-revalidate means the one visitor
 * who does hit an expired entry is served instantly while it refreshes behind
 * them. A photograph therefore appears within a minute of being uploaded
 * rather than within a deploy, and the page still costs a static page's time.
 */
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=86400'
);
---

<Marketing
  locale={locale}
  pageKey="home"
  title={s.meta.home.title}
  description={s.meta.home.description}
  canonical={alt.canonical}
  alternates={alt.list}
  xDefault={alt.xDefault}
  prefill={s.contact.prefillGeneral}
  business
>
  <div class="home">
    {/* ══ 1 · Hero ═══════════════════════════════════════════════════ */}
    <section class="hero">
      <div class="hero__media">
        <HeroMedia locale={locale} desktop={media['hero']} mobile={media['hero-mobile']} scrim="bottom" />
      </div>

      <div class="wrap hero__inner">
        <p class="eyebrow hero__eyebrow">{c.heroEyebrow}</p>
        <h1 class="hero__title">{c.heroTitle}</h1>
        <p class="hero__lead">{c.heroLead}</p>

        <div class="hero__acts">
          <a class="btn btn--foil btn--lg" href={path('quote', locale)}>{c.heroPrimary}</a>
          {wa && (
            <a class="btn btn--ghost btn--lg" href={wa} target="_blank" rel="noopener nofollow">
              {c.heroSecondary}
            </a>
          )}
        </div>

        <p class="hero__prompt">{c.heroPrompt}</p>
      </div>

      {/* Three checkable statements, sitting on the seam between the hero and
          the page. Placed here because this is where the visitor decides
          whether to keep scrolling at all. */}
      <div class="wrap">
        <ul class="assure reveal">
          {ASSURANCES.map((a) => (
            <li class="assure__item">
              <h2 class="assure__title">{a.title[locale]}</h2>
              <p class="assure__body">{a.body[locale]}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ══ 2 · Proof ══════════════════════════════════════════════════ */}
    <section class="section s-proof">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="eyebrow">{c.proofEyebrow}</p>
          <h2>{c.proofTitle}</h2>
          <p class="lead">{c.proofLead}</p>
        </header>

        {pairs.length ? (
          <ul class="proof">
            {pairs.map((m, i) => (
              <li class="proof__item reveal">
                <MediaSlot slot="gallery" locale={locale} media={m} ratio="4 / 5" priority={i === 0} />
              </li>
            ))}
          </ul>
        ) : (
          <div class="proof proof--empty">
            {[0, 1].map((i) => (
              <div class="proof__item reveal">
                <MediaSlot
                  slot="gallery"
                  locale={locale}
                  ratio="4 / 5"
                  label={locale === 'is'
                    ? (i === 0 ? 'Áður · sama ljós og sjónarhorn' : 'Eftir · sama ljós og sjónarhorn')
                    : (i === 0 ? 'Before · same light and angle' : 'After · same light and angle')}
                />
              </div>
            ))}
            <p class="proof__note">{c.proofEmpty}</p>
          </div>
        )}

        <p class="reveal"><a class="link-arrow" href={path('results', locale)}>{c.proofCta}</a></p>
      </div>
    </section>

    {/* ══ 3 · What we clean ══════════════════════════════════════════ */}
    <section class="section section--sunk s-fields">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="eyebrow">{c.fieldsEyebrow}</p>
          <h2>{c.fieldsTitle}</h2>
          <p class="lead">{c.fieldsLead}</p>
        </header>

        <ul class="fields">
          {FIELDS.map((f) => (
            <li class="fields__item reveal">
              <a class="field" href={path(f.key, locale)}>
                <MediaSlot
                  slot={f.slot}
                  locale={locale}
                  media={media[f.slot]}
                  ratio="4 / 5"
                  label={s.services[f.key].name}
                  class="field__shot"
                />
                <span class="field__body">
                  <span class="field__name">{s.services[f.key].name}</span>
                  <span class="field__lead">{s.services[f.key].body}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ══ 4 · Will the stain come out ════════════════════════════════ */}
    <section class="section s-stain">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="eyebrow">{c.stainEyebrow}</p>
          <h2>{c.stainTitle}</h2>
          <p class="lead">{c.stainLead}</p>
        </header>

        <div class="reveal">
          <StainRegister locale={locale} />
        </div>
      </div>
    </section>

    {/* ══ 5 · The material decides ═══════════════════════════════════ */}
    <section class="section section--deep s-care">
      <div class="wrap care">
        <div class="care__text reveal">
          <p class="eyebrow">{c.careEyebrow}</p>
          <h2>{c.careTitle}</h2>
          <p class="lead">{c.careLead}</p>
          <p><a class="link-arrow" href={path('process', locale)}>{c.careCta}</a></p>
        </div>

        <div class="care__shot reveal">
          <MediaSlot
            slot="home-fibre"
            locale={locale}
            media={media['home-fibre']}
            ratio="4 / 5"
            label={locale === 'is'
              ? 'Nærmynd af ló í ská-birtu · engin hönd í ramma'
              : 'Macro of pile in raking light · no hand in frame'}
          />
        </div>
      </div>
    </section>

    {/* ══ 6 · What we will not do ════════════════════════════════════ */}
    <section class="section s-refuse">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="eyebrow">{c.refuseEyebrow}</p>
          <h2>{c.refuseTitle}</h2>
          <p class="lead">{c.refuseLead}</p>
        </header>

        <ul class="refuse">
          {REFUSALS.map((r) => (
            <li class="refuse__item reveal">
              <p class="refuse__no">{r.no[locale]}</p>
              <p class="refuse__label">{c.refuseInstead}</p>
              <p class="refuse__yes">{r.instead[locale]}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ══ 7 · How it works ═══════════════════════════════════════════ */}
    <section class="section section--sunk s-steps">
      <div class="wrap">
        <header class="section-head reveal">
          <p class="eyebrow">{c.stepsEyebrow}</p>
          <h2>{c.stepsTitle}</h2>
        </header>

        <ol class="steps">
          {STEPS.map((st) => (
            <li class="steps__item reveal">
              <p class="steps__n" aria-hidden="true">{st.n}</p>
              <h3 class="steps__title">{st.title[locale]}</h3>
              <p class="steps__body">{st.body[locale]}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ══ 8 · Areas ══════════════════════════════════════════════════ */}
    <section class="section section--tight s-areas">
      <div class="wrap stack stack--24">
        <header class="section-head reveal">
          <p class="eyebrow">{c.areasEyebrow}</p>
          <h2>{c.areasTitle}</h2>
          <p class="lead">{c.areasLead}</p>
        </header>

        <ul class="areas reveal">
          {SITE.areas.map((area) => (
            <li><a class="area" href={areaPath(area.slug, locale)}>{area.name}</a></li>
          ))}
        </ul>

        <p class="reveal"><a class="link-arrow" href={path('areas', locale)}>{c.areasCta}</a></p>
      </div>
    </section>

    {/* ══ 9 · Close ══════════════════════════════════════════════════ */}
    <div class="s-close">
      <ClosingCta locale={locale} prefill={s.contact.prefillGeneral} />
    </div>
  </div>
</Marketing>

<style>
  .home { display: flex; flex-direction: column; }

  /* ------------------------------------------------------------------ *
   * Scroll reveal.
   *
   * Scroll-driven CSS animation, so this costs no JavaScript at all — the
   * site ships none and a reveal effect is not worth breaking that for. In a
   * browser without animation-timeline the @supports block never applies and
   * the content is simply there, which is the correct fallback rather than a
   * degraded one.
   *
   * 14px and 700ms: far enough to register as movement, near enough that
   * nothing appears to fly. Anything larger is what makes a page feel like a
   * template.
   * ------------------------------------------------------------------ */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .reveal {
        animation: reveal linear both;
        animation-timeline: view();
        animation-range: entry 8% cover 26%;
      }

      @keyframes reveal {
        from { opacity: 0; transform: translateY(14px); }
        to   { opacity: 1; transform: none; }
      }
    }
  }

  /* ------------------------------------------------------------------ *
   * Hero
   *
   * The photograph is the page's first argument, so it gets the frame and the
   * copy sits on it. min-height rather than 100vh: a hero that exactly fills
   * a phone screen hides the fact that there is anything below it, and the
   * one thing this page needs is for people to keep going.
   * ------------------------------------------------------------------ */
  .hero { position: relative; padding-block-end: var(--space-800); }

  .hero__media {
    position: absolute;
    inset: 0 0 auto;
    height: min(88svh, 46rem);
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-300);
    min-height: min(78svh, 40rem);
    padding-block: var(--space-800) var(--space-600);
    justify-content: flex-end;
  }

  .hero__eyebrow { color: var(--text-accent); }

  .hero__title {
    font-family: var(--font-display);
    font-size: var(--display-xl, clamp(2.5rem, 7vw, 4.75rem));
    line-height: 1.03;
    letter-spacing: -0.015em;
    color: var(--text-primary);
    max-width: 15ch;
    text-wrap: balance;
    margin: 0;
  }

  .hero__lead {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 46ch;
    text-wrap: pretty;
  }

  .hero__acts { display: flex; flex-wrap: wrap; gap: var(--space-200); }

  .hero__prompt {
    font: var(--type-mono);
    font-size: 12px;
    letter-spacing: var(--tracking-label);
    color: var(--text-muted);
  }

  /* ---- the three assurances ---- */

  .assure {
    display: grid;
    gap: var(--space-400);
    padding-block-start: var(--space-500);
    border-block-start: 1px solid var(--edge-quiet);
  }

  .assure__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--text-primary);
    margin: 0 0 var(--space-100);
  }

  .assure__body { font-size: var(--text-sm); color: var(--text-muted); max-width: 40ch; }

  /* ------------------------------------------------------------------ *
   * Proof
   * ------------------------------------------------------------------ */
  .proof {
    display: grid;
    gap: var(--space-300);
    margin-block: var(--space-500);
  }

  .proof__note {
    grid-column: 1 / -1;
    font-size: var(--text-sm);
    color: var(--text-muted);
    max-width: 52ch;
  }

  /* ------------------------------------------------------------------ *
   * Fields — a photograph each, because "sofa cleaning" as a word does not
   * sell and a photograph of a clean sofa does.
   * ------------------------------------------------------------------ */
  .fields {
    display: grid;
    gap: var(--space-400);
    margin-block-start: var(--space-500);
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-250);
    text-decoration: none;
    color: inherit;
  }

  .field__shot { overflow: hidden; border-radius: var(--radius-sm); }

  .field__shot :global(img),
  .field__shot :global(video) {
    transition: transform var(--dur-slow, 640ms) var(--ease-glide);
  }

  .field:hover .field__shot :global(img),
  .field:hover .field__shot :global(video) { transform: scale(1.03); }

  .field__body { display: flex; flex-direction: column; gap: var(--space-100); }

  .field__name {
    font-family: var(--font-display);
    font-size: var(--display-xs);
    color: var(--text-primary);
  }

  .field__lead { font-size: var(--text-sm); color: var(--text-muted); max-width: 40ch; }

  /* ------------------------------------------------------------------ *
   * Care — text and one photograph, side by side on a wide screen.
   * ------------------------------------------------------------------ */
  .care { display: grid; gap: var(--space-500); align-items: center; }
  .care__text { display: flex; flex-direction: column; gap: var(--space-250); }

  /* ------------------------------------------------------------------ *
   * Refusals
   *
   * The one section that argues by subtraction. Each entry is a refusal and
   * the thing done instead, so it never reads as a list of things the
   * business cannot manage.
   * ------------------------------------------------------------------ */
  .refuse {
    display: grid;
    gap: var(--space-400);
    margin-block-start: var(--space-500);
  }

  .refuse__item {
    padding-block-start: var(--space-300);
    border-block-start: 1px solid var(--edge-quiet);
  }

  .refuse__no {
    font-family: var(--font-display);
    font-size: var(--display-xs);
    color: var(--text-primary);
    margin-block-end: var(--space-200);
    text-wrap: balance;
  }

  .refuse__label {
    font: var(--type-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-accent);
    margin-block-end: var(--space-075);
  }

  .refuse__yes { font-size: var(--text-sm); color: var(--text-secondary); max-width: 44ch; }

  /* ------------------------------------------------------------------ *
   * Steps
   * ------------------------------------------------------------------ */
  .steps {
    display: grid;
    gap: var(--space-400);
    margin-block-start: var(--space-500);
    counter-reset: none;
  }

  .steps__item {
    padding-block-start: var(--space-300);
    border-block-start: 1px solid var(--edge-quiet);
  }

  .steps__n {
    font: var(--type-mono);
    font-size: 12px;
    letter-spacing: var(--tracking-label);
    color: var(--text-accent);
    margin-block-end: var(--space-200);
  }

  .steps__title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--text-primary);
    margin: 0 0 var(--space-100);
  }

  .steps__body { font-size: var(--text-sm); color: var(--text-muted); max-width: 38ch; }

  /* ------------------------------------------------------------------ *
   * Wide screens
   * ------------------------------------------------------------------ */
  @media (min-width: 48rem) {
    .assure { grid-template-columns: repeat(3, 1fr); }
    .proof { grid-template-columns: repeat(2, 1fr); gap: var(--space-400); }
    .fields { grid-template-columns: repeat(2, 1fr); gap: var(--space-500); }
    .refuse { grid-template-columns: repeat(2, 1fr); gap: var(--space-500); }
    .steps { grid-template-columns: repeat(2, 1fr); gap: var(--space-500); }
  }

  @media (min-width: 64rem) {
    .hero__inner { padding-block: var(--space-1000) var(--space-800); }
    .fields { grid-template-columns: repeat(4, 1fr); gap: var(--space-400); }
    .steps { grid-template-columns: repeat(4, 1fr); }
    .care { grid-template-columns: 1fr minmax(0, 22rem); gap: var(--space-800); }
    .proof { grid-template-columns: repeat(4, 1fr); }
  }
</style>
