---
import Marketing from '~/layouts/Marketing.astro';
import ContactChannels from '~/components/ContactChannels.astro';
import ClosingCta from '~/components/ClosingCta.astro';
import HeroMedia from '~/components/HeroMedia.astro';
import MediaSlot from '~/components/MediaSlot.astro';
import Constructions from '~/components/home/Constructions.astro';
import StainRegister from '~/components/home/StainRegister.astro';
import FibreRegister from '~/components/home/FibreRegister.astro';

import { LOCALES, SITE, type Locale } from '~/config/site';
import { t, alternates } from '~/i18n';
import { path, areaPath, SERVICE_KEYS } from '~/i18n/routes';
import { slotMap, type MediaRow } from '~/lib/media';
import { env } from '~/lib/admin-guard';
import { HOME_COPY, CARE_CODES, REFUSALS, CONSTRUCTION_LABEL, type Construction } from '~/data/home';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: locale }, props: { locale } }));
}

const { locale } = Astro.props as { locale: Locale };
const s = t(locale);
const c = HOME_COPY[locale];
const alt = alternates('home', locale);

/**
 * The homepage sells without a price and without a single review, because
 * neither exists. What carries persuasion instead is specificity: the same
 * knowledge indexed twice — once on the stain the visitor is looking at, once
 * on the material it is sitting in — with the affirmative answer given first
 * and the limit given second.
 *
 * The registers live in src/data/home.ts so both languages stay in lockstep.
 */
let media: Record<string, MediaRow | undefined> = {};
{
  const { DB } = env(Astro);
  if (DB) {
    try {
      media = await slotMap(DB, ['hero', 'hero-mobile', 'home-label', 'home-fibre', 'home-1']);
    } catch { /* reserved plates */ }
  }
}

const heroDesktop = media['hero'];
const heroMobile = media['hero-mobile'];
const hasHeroImage = Boolean(heroDesktop || heroMobile);

/** The six constructions, as a strip of anchors into the fibre register. */
const STRIP: Construction[] = ['plain', 'twill', 'cutpile', 'looppile', 'knotted', 'hide'];
const SYMBOL: Record<Construction, string> = {
  plain: 'c-plain', twill: 'c-twill', cutpile: 'c-cutpile',
  looppile: 'c-looppile', knotted: 'c-knotted', hide: 'c-hide',
};
---

<Marketing
  locale={locale}
  pageKey="home"
  title={s.meta.home.title}
  description={s.meta.home.description}
  canonical={alt.canonical}
  alternates={alt.list}
  xDefault={alt.xDefault}
  prefill={s.contact.prefillGeneral}
  business
>
  <Constructions />

  <div class="home">
    {/* ══ 1 · Hero ══════════════════════════════════════════════════ */}
    <section class:list={['s-hero', { 's-hero--shot': hasHeroImage }]}>
      <HeroMedia locale={locale} desktop={heroDesktop} mobile={heroMobile} scrim="left" />

      <div class="wrap hero__inner">
        <div class="hero__type">
          <p class="eyebrow">{c.eyebrow}</p>
          <h1 class="hero__title">{c.title}</h1>
          <div class="silfrun-rule hero__rule"></div>
          <p class="lead hero__lead">{c.lead}</p>
        </div>

        <div class="hero__act">
          <ContactChannels locale={locale} variant="hero" prefill={s.contact.prefillGeneral} note={false} />
          <p class="hero__secondary">
            <a class="link-arrow" href="#blettaskra">{c.seeRegister}</a>
          </p>
          <p class="hero__note">{c.note}</p>
        </div>
      </div>

      {/*
        The construction strip is navigation into the register, not the hero
        image. It sits at the foot of the hero deliberately: on a phone the
        second row is half-cropped by the fold, and that partial row is the
        only scroll signal on the page.
      */}
      <div class="wrap cstrip__wrap">
        <p class="cstrip__label">{c.constructionsLabel}</p>
        <ul class="cstrip">
          {STRIP.map((k) => (
            <li>
              <a class="cstrip__item" href="#efnisskra">
                <svg class="cstrip__fig" viewBox="0 0 64 40" aria-hidden="true"><use href={`#${SYMBOL[k]}`} /></svg>
                <span class="cstrip__name">{CONSTRUCTION_LABEL[k][locale]}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ══ 2 · Blettaskráin — the question they actually arrived with ══ */}
    <section class="section s-stain" id="blettaskra">
      <div class="wrap">
        <header class="section-head">
          <p class="eyebrow">{c.stainEyebrow}</p>
          <h2>{c.stainTitle}</h2>
          <p class="lead">{c.stainLead}</p>
        </header>
        <StainRegister locale={locale} />
      </div>
    </section>

    {/* ══ 3 · The care label — a task that takes half a minute ═══════ */}
    <section class="section section--sunk s-label">
      <div class="wrap label__wrap">
        <div class="label__body">
          <h2>{c.labelTitle}</h2>
          <p class="lead label__lead">{c.labelLead}</p>

          <ul class="codes">
            {CARE_CODES.map((code) => (
              <li class="code">
                <span class="code__letter" aria-hidden="true">{code.code}</span>
                <span class="code__meaning">{code.meaning[locale]}</span>
              </li>
            ))}
          </ul>

          <p class="label__closing">{c.labelClosing}</p>
        </div>

        <div class="label__plate">
          <MediaSlot
            slot="home-label"
            locale={locale}
            media={media['home-label']}
            ratio="1 / 1"
            label={locale === 'is'
              ? 'Umhirðumerking undir sessu · nærmynd í dagsbirtu'
              : 'Care label under a cushion · daylight macro'}
          />
        </div>
      </div>
    </section>

    {/* ══ 4 · What we do not do — each refusal answered ══════════════ */}
    <section class="section section--deep s-refuse">
      <div class="wrap">
        <h2 class="refuse__title">{c.refuseTitle}</h2>

        <div class="refuse">
          {REFUSALS.map((r) => (
            <div class="refuse__row">
              <p class="refuse__no">{r.no[locale]}</p>
              <div class="refuse__yes">
                <p class="refuse__label">{c.refuseInstead}</p>
                <p class="refuse__body">{r.instead[locale]}</p>
              </div>
            </div>
          ))}
        </div>

        <p class="refuse__closing">{c.refuseClosing}</p>
      </div>
    </section>

    {/* ══ 5 · Efnisskráin — desktop pulls this up to position 2 ══════ */}
    <section class="section s-fibre" id="efnisskra">
      <div class="wrap">
        <header class="section-head fibre__head">
          <div>
            <p class="eyebrow">{c.fibreEyebrow}</p>
            <h2>{c.fibreTitle}</h2>
            <p class="lead">{c.fibreLead}</p>
          </div>
          <div class="fibre__plate">
            <MediaSlot
              slot="home-fibre"
              locale={locale}
              media={media['home-fibre']}
              ratio="1 / 1"
              label={locale === 'is'
                ? 'Nærmynd af ló í ská-birtu · engin hönd í ramma'
                : 'Macro of pile in raking light · no hand in frame'}
            />
          </div>
        </header>

        <FibreRegister locale={locale} />
      </div>
    </section>

    {/* ══ 6 · Services ══════════════════════════════════════════════ */}
    <section class="section section--sunk s-fields">
      <div class="wrap stack stack--32">
        <header class="section-head">
          <p class="eyebrow">{s.services.eyebrow}</p>
          <h2>{s.services.title}</h2>
        </header>

        <ul class="fields">
          {SERVICE_KEYS.map((key) => (
            <li>
              <a class="field" href={path(key, locale)}>
                <span class="field__name">{s.services[key].name}</span>
                <span class="field__lead">{s.services[key].body}</span>
                <span class="field__go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ══ 7 · Areas ═════════════════════════════════════════════════ */}
    <section class="section section--tight s-areas">
      <div class="wrap stack stack--24">
        <header class="section-head">
          <p class="eyebrow">{s.areas.eyebrow}</p>
          <h2>{s.areas.title}</h2>
          <p class="lead">{s.areas.lead}</p>
        </header>

        <ul class="areas">
          {SITE.areas.map((area) => (
            <li><a class="area" href={areaPath(area.slug, locale)}>{area.name}</a></li>
          ))}
        </ul>

        <p><a class="link-arrow" href={path('areas', locale)}>{s.areas.cta}</a></p>
      </div>
    </section>

    {/* ══ 8 · Close ═════════════════════════════════════════════════ */}
    <div class="s-close">
      <ClosingCta locale={locale} prefill={s.contact.prefillGeneral} />
    </div>
  </div>
</Marketing>

<style>
  /**
   * The page is a flex column so desktop can re-rank exactly one section.
   *
   * On a phone the stain register comes first, because the visitor is holding
   * the stain. On a desktop the fibre register jumps to position two, because
   * a four-column aligned table is a breadth-in-one-glance impression that
   * only exists at width — on a phone it is eleven cards and makes no such
   * impression, so it earns its place later.
   *
   * Tab order follows DOM order, which is the phone order. Acceptable here
   * because every section is self-contained and none depends on the last.
   */
  .home { display: flex; flex-direction: column; }

  @media (min-width: 64rem) {
    .home > .s-hero   { order: 1; }
    .home > .s-fibre  { order: 2; }
    .home > .s-stain  { order: 3; }
    .home > .s-label  { order: 4; }
    .home > .s-refuse { order: 5; }
    .home > .s-fields { order: 6; }
    .home > .s-areas  { order: 7; }
    .home > .s-close  { order: 8; }
  }

  /* ══ hero ═══════════════════════════════════════════════════════ */

  .s-hero {
    position: relative;
    isolation: isolate;
    padding-block: var(--space-1000) var(--space-500);
  }

  .hero__inner,
  .cstrip__wrap { position: relative; z-index: 1; }

  .hero__type { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-200); }

  .hero__title {
    font-size: var(--display-2xl);
    letter-spacing: var(--tracking-display-tight);
    line-height: var(--leading-display);
    max-width: 9em;
    margin-block-start: var(--space-100);
  }

  .hero__rule { max-width: 8rem; margin-block: var(--space-200); }
  .hero__lead { max-width: 36ch; }

  .hero__act { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-250); margin-block-start: var(--space-400); }
  .hero__secondary { margin: 0; }
  .hero__note { font: var(--type-mono); color: var(--text-muted); max-width: 34ch; }

  /* With a photograph the hero becomes a stage rather than type on the page. */
  .s-hero--shot { min-height: 82svh; display: flex; flex-direction: column; justify-content: flex-end; }
  .s-hero--shot .hero__title,
  .s-hero--shot .hero__lead { color: var(--plate-text); }
  .s-hero--shot .eyebrow,
  .s-hero--shot .hero__note { color: var(--plate-text-secondary); }

  /* ---- construction strip ---- */

  .cstrip__wrap {
    margin-block-start: var(--space-600);
    padding-block-start: var(--space-400);
    border-block-start: 1px solid var(--edge-hairline);
  }

  .cstrip__label {
    font: var(--type-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
    margin-block-end: var(--space-300);
    max-width: none;
  }

  .cstrip { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-300) var(--space-200); }

  .cstrip__item {
    display: grid;
    gap: var(--space-150);
    min-height: 44px;
    text-decoration: none;
  }

  .cstrip__fig {
    width: 100%;
    height: 84px;
    color: var(--text-muted);
    transition: color var(--dur-base) var(--ease-glide);
  }

  .cstrip__item:hover .cstrip__fig { color: var(--text-primary); }

  .cstrip__name {
    font: var(--type-mono);
    font-size: 10.5px;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* ══ care label ══════════════════════════════════════════════════ */

  .label__wrap { display: grid; grid-template-columns: 1fr; gap: var(--space-500); }
  .label__lead { max-width: 44ch; margin-block-start: var(--space-250); }

  .codes { display: flex; flex-direction: column; margin-block: var(--space-500) var(--space-400); }

  .code {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: var(--space-250);
    align-items: center;
    padding-block: var(--space-250);
    border-block-start: 1px solid var(--edge-quiet);
  }

  .code__letter {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 34px;
    border: 1px solid var(--edge-strong);
    border-radius: var(--radius-xs);
    font: var(--type-mono);
    font-size: var(--text-sm);
    letter-spacing: .08em;
    color: var(--text-primary);
  }

  .code__meaning { font-size: var(--text-sm); color: var(--text-secondary); }

  .label__closing { font-size: var(--text-sm); color: var(--text-muted); max-width: 50ch; }

  /* On a phone the instruction must arrive before the illustration of it. */
  .label__plate { order: 2; }

  /* ══ refusals ════════════════════════════════════════════════════ */

  .refuse__title { font-size: var(--display-lg); max-width: var(--measure-display); margin-block-end: var(--space-500); }

  .refuse { display: flex; flex-direction: column; }

  .refuse__row { padding-block: var(--space-500); border-block-start: 1px solid var(--plate-edge); }

  .refuse__no {
    font-family: var(--font-display);
    font-size: var(--display-sm);
    line-height: var(--leading-display-loose);
    color: var(--plate-text);
    max-width: var(--measure-display);
    text-wrap: balance;
    margin-block-end: var(--space-250);
  }

  .refuse__label {
    font: var(--type-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--text-accent);
    margin-block-end: var(--space-150);
    max-width: none;
  }

  .refuse__body { font-size: var(--text-sm); color: var(--plate-text-secondary); max-width: 46ch; }

  .refuse__closing {
    margin-block-start: var(--space-600);
    padding-block-start: var(--space-400);
    border-block-start: 1px solid var(--plate-edge);
    font: var(--type-mono);
    color: var(--plate-text-secondary);
    max-width: 56ch;
  }

  /* ══ fibre register head ═════════════════════════════════════════ */

  .fibre__head { display: grid; grid-template-columns: 1fr; gap: var(--space-400); }

  /* A phone does not spend a square on an absence; the section reads fine
     without it, and a real photograph appears at every width. */
  @media (max-width: 63.99rem) {
    .fibre__plate :global(.ms--empty) { display: none; }
  }

  /* ══ services ════════════════════════════════════════════════════ */

  .fields { display: grid; grid-template-columns: 1fr; }

  .field {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-100) var(--space-300);
    align-items: baseline;
    padding-block: var(--space-400);
    border-block-start: 1px solid var(--edge-quiet);
    transition: var(--transition-control);
  }

  .field:hover { padding-inline-start: var(--space-200); }

  .field__name { font-family: var(--font-display); font-size: var(--display-xs); color: var(--text-primary); }
  .field__lead { grid-column: 1 / -1; font-size: var(--text-sm); color: var(--text-muted); max-width: 52ch; }
  .field__go { color: var(--text-accent); }

  /* ══ areas ═══════════════════════════════════════════════════════ */

  .areas { display: flex; flex-wrap: wrap; gap: var(--space-150); }

  .area {
    display: inline-flex;
    align-items: center;
    height: var(--control-h);
    padding: 0 var(--pad-control-x);
    border: 1px solid var(--edge-hairline);
    border-radius: var(--radius-pill);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition: var(--transition-control);
  }

  .area:hover { border-color: var(--edge-strong); color: var(--text-primary); }

  /* ══════════════════════════════════════════════════════════════════
     Desktop. Not the same layout widened — different composition per
     section, and one section re-ranked.
     ══════════════════════════════════════════════════════════════════ */

  @media (min-width: 64rem) {
    .s-hero {
      min-height: min(84svh, 54rem);
      display: grid;
      grid-template-rows: 1fr auto;
      padding-block: clamp(var(--space-1200), 12vw, var(--space-2000)) var(--space-600);
    }

    .hero__inner {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      column-gap: var(--space-400);
      align-content: center;
    }

    /* Left seven of twelve. The right five stay empty — that emptiness is
       what the width is for, and it is the whole restraint argument. */
    .hero__type { grid-column: 1 / 8; }
    .hero__act  { grid-column: 1 / 7; margin-block-start: var(--space-500); }

    .hero__title { font-size: var(--display-3xl); max-width: var(--measure-display-tight); }
    .hero__lead { max-width: 42ch; }

    .cstrip { grid-template-columns: repeat(6, 1fr); column-gap: var(--space-400); }
    .cstrip__fig { height: 56px; }

    .label__wrap { grid-template-columns: minmax(0, 1fr) 22rem; column-gap: var(--space-1000); align-items: start; }
    .label__plate { order: 0; position: sticky; top: var(--space-800); }

    .codes { display: grid; grid-template-columns: 1fr 1fr; gap: 0 var(--space-500); }

    .refuse__row {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      column-gap: var(--space-1000);
      align-items: start;
    }

    .refuse__no { margin-block-end: 0; }
    .refuse__yes { align-self: center; }

    .fibre__head { grid-template-columns: minmax(0, 1fr) 14rem; gap: var(--space-800); align-items: start; }

    .fields { grid-template-columns: 1fr 1fr; column-gap: var(--space-800); }
  }

  /*
   * A CSS-only reveal on the refusals, guarded twice: the feature query keeps
   * it out of browsers without scroll-driven animation, and the motion query
   * keeps it away from anyone who has asked for less movement.
   */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .refuse__no {
        animation: settle linear both;
        animation-timeline: view();
        animation-range: entry 10% entry 55%;
      }
      @keyframes settle {
        from { opacity: 0; transform: translateY(1.25rem); }
        to   { opacity: 1; transform: none; }
      }
    }
  }
</style>
