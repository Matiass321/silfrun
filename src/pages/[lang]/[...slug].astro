---
import Marketing from '~/layouts/Marketing.astro';
import ServicePage from '~/components/pages/ServicePage.astro';
import ProsePage from '~/components/pages/ProsePage.astro';
import FaqPage from '~/components/pages/FaqPage.astro';
import ListPage from '~/components/pages/ListPage.astro';
import ContactPage from '~/components/pages/ContactPage.astro';
import ProcessPage from '~/components/pages/ProcessPage.astro';

import { LOCALES, SITE, type Locale } from '~/config/site';
import { SLUGS, SERVICE_KEYS, type PageKey, type ServiceKey } from '~/i18n/routes';

import { t, alternates, areaAlternates } from '~/i18n';
import { PAGE_META, AREA_META } from '~/i18n/meta';
import { CONTENT } from '~/data/content';
import { slotMap, type MediaRow } from '~/lib/media';
import { env } from '~/lib/admin-guard';

/**
 * Resolves every translated slug to the page that owns it.
 *
 * Routing is driven by the slug table rather than by the filesystem, because
 * the filesystem cannot produce translated path segments — /is/sofahreinsun/
 * and /en/sofa-cleaning/ are the same page. Service-area pages are emitted
 * here too, beneath the translated areas slug.
 *
 * Only keys listed in `built` are emitted. Anything else 404s until its
 * template exists, rather than shipping an empty shell.
 */
export function getStaticPaths() {
  const built: PageKey[] = [
    ...SERVICE_KEYS,
    'services',
    'process',
    'results',
    'areas',
    'about',
    'faq',
    'quote',
    'contact',
    'privacy',
    'terms',
  ];

  const paths = [];

  for (const locale of LOCALES) {
    for (const key of built) {
      paths.push({
        params: { lang: locale, slug: SLUGS[key][locale] },
        props: { locale, pageKey: key, area: null },
      });
    }

    for (const area of SITE.areas) {
      paths.push({
        params: { lang: locale, slug: `${SLUGS.areas[locale]}/${area.slug}` },
        props: { locale, pageKey: 'areas' as PageKey, area },
      });
    }
  }

  return paths;
}

type AreaProp = { slug: string; name: string; dative: string; prep: string; primary: boolean } | null;

const { locale, pageKey, area } = Astro.props as {
  locale: Locale;
  pageKey: PageKey;
  area: AreaProp;
};

const s = t(locale);
const c = CONTENT[locale];

const isService = (SERVICE_KEYS as readonly PageKey[]).includes(pageKey);

/**
 * Area pages compose their title and description from a per-locale pattern
 * rather than being hand-written six times. Everything else reads from the
 * meta table, so no description is ever a recycled piece of body copy.
 */
let title: string;
let description: string;
let alt: ReturnType<typeof alternates>;

if (area) {
  /**
   * Icelandic inflects after a preposition, so the placeholder is filled with
   * the whole prepositional phrase — "í Kópavogi", "á Seltjarnarnesi" — not
   * the bare name. English has no case and keeps "in " + the plain name.
   */
  const placed = locale === 'is' ? `${area.prep} ${area.dative}` : area.name;
  title = AREA_META[locale].title.replace('{area}', placed);
  description = AREA_META[locale].description.replace('{area}', placed);
  alt = areaAlternates(area.slug, locale);
} else {
  const meta = PAGE_META[locale][pageKey];
  title = meta.title;
  description = meta.description;
  alt = alternates(pageKey, locale);
}

/**
 * Media for this page, resolved in a single query.
 *
 * Only the slots this page can actually show are asked for. A page requesting
 * every slot would read the whole library to render four frames.
 *
 * Prerendered pages have no runtime binding, so this is empty at build time
 * and the slots render their marked plates — which is the correct state until
 * photographs exist. Once they do, the page is rebuilt and they appear.
 */
const wantedSlots = isService
  ? [pageKey]
  : pageKey === 'process'
    ? ['process-1', 'process-2', 'process-3', 'process-4']
    : pageKey === 'about'
      ? ['about']
      : [];

let media: Record<string, MediaRow | undefined> = {};
if (wantedSlots.length) {
  const { DB } = env(Astro);
  if (DB) { try { media = await slotMap(DB, wantedSlots); } catch { /* plates */ } }
}

/**
 * The first message the visitor sends, written for the page they are on.
 *
 * A conversation that opens with "I would like to ask about rug cleaning"
 * saves the visitor from composing anything and saves the business from having
 * to ask what the enquiry is about. Both halves matter: the message is the
 * enquiry's first line of context, not decoration.
 */
const prefill = area
  ? s.contact.prefillArea.replace('{area}', locale === 'is' ? `${area.prep} ${area.dative}` : area.name)
  : isService
    ? s.contact.prefillService.replace('{service}', s.services[pageKey as ServiceKey].name.toLowerCase())
    : pageKey === 'quote'
      ? s.contact.prefillQuote
      : s.contact.prefillGeneral;

/**
 * Page-level structured data.
 *
 * Service pages describe an offering with a real provider and area; the
 * process page is a genuine HowTo; contact pages declare themselves as such.
 * Nothing here is emitted speculatively — a Service with no provider or an
 * Offer with no price is noise that dilutes the rest of the graph.
 */
const pageLd: object[] = [];

if (isService) {
  const key = pageKey as ServiceKey;
  pageLd.push({
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${alt.canonical}#service`,
    name: s.services[key].name,
    description,
    serviceType: s.services[key].name,
    provider: { '@id': `${SITE.url}/#business` },
    areaServed: SITE.areas.map((a) => ({ '@type': 'City', name: a.name })),
    availableChannel: {
      '@type': 'ServiceChannel',
      serviceUrl: alt.canonical,
      availableLanguage: [
        { '@type': 'Language', name: 'Icelandic', alternateName: 'is' },
        { '@type': 'Language', name: 'English', alternateName: 'en' },
      ],
    },
  });
}

if (pageKey === 'process') {
  pageLd.push({
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    '@id': `${alt.canonical}#howto`,
    name: s.process.title,
    description,
    inLanguage: locale === 'is' ? 'is-IS' : 'en-GB',
    step: s.process.steps.map((step, i) => ({
      '@type': 'HowToStep',
      position: i + 1,
      name: step.title,
      text: step.body,
    })),
  });
}

if (pageKey === 'contact' || pageKey === 'quote') {
  pageLd.push({
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    '@id': `${alt.canonical}#contactpage`,
    name: title,
    description,
    mainEntity: { '@id': `${SITE.url}/#business` },
  });
}

if (area) {
  /* The area page is about a place the business serves, stated as such. */
  pageLd.push({
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${alt.canonical}#service`,
    name: title,
    description,
    provider: { '@id': `${SITE.url}/#business` },
    areaServed: { '@type': 'City', name: area.name, containedInPlace: { '@type': 'Country', name: 'Iceland' } },
  });
}
---

<Marketing
  locale={locale}
  pageKey={pageKey}
  title={title}
  description={description}
  canonical={alt.canonical}
  alternates={alt.list}
  xDefault={alt.xDefault}
  jsonLd={pageLd}
  prefill={prefill}
>
  {isService && <ServicePage locale={locale} service={pageKey as ServiceKey} />}

  {pageKey === 'services' && <ListPage locale={locale} variant="services" />}
  {pageKey === 'areas' && !area && <ListPage locale={locale} variant="areas" />}
  {pageKey === 'areas' && area && <ListPage locale={locale} variant="area" area={area} />}

  {pageKey === 'faq' && <FaqPage locale={locale} />}

  {pageKey === 'quote' && <ContactPage locale={locale} variant="quote" />}
  {pageKey === 'contact' && <ContactPage locale={locale} variant="contact" />}


  {pageKey === 'process' && <ProcessPage locale={locale} media={media} />}
  {pageKey === 'results' && (
    <ProsePage locale={locale} heading={s.work.title} eyebrow={s.work.eyebrow} page={c.results} />
  )}
  {pageKey === 'about' && (
    <ProsePage locale={locale} heading={s.nav.about} eyebrow={s.why.eyebrow} page={c.about} />
  )}

  {pageKey === 'privacy' && (
    <ProsePage
      locale={locale}
      heading={PAGE_META[locale].privacy.title}
      eyebrow={locale === 'is' ? 'Lagalegt' : 'Legal'}
      page={c.privacy}
      legal
      cta={false}
    />
  )}
  {pageKey === 'terms' && (
    <ProsePage
      locale={locale}
      heading={PAGE_META[locale].terms.title}
      eyebrow={locale === 'is' ? 'Lagalegt' : 'Legal'}
      page={c.terms}
      legal
      cta={false}
    />
  )}
</Marketing>
