---
import Admin from '~/layouts/Admin.astro';
import VisitCard from '~/components/admin/VisitCard.astro';
import { requireAdmin, env } from '~/lib/admin-guard';
import {
  listVisits, getVisit, parseItems, formatPhone,
  VISIT_STATUSES, type VisitRow, type VisitStatus,
} from '~/lib/visits';
import { isk, clock, longDate, isoDate } from '~/lib/time';
import { ADMIN_ICONS } from '~/data/admin-icons';

export const prerender = false;

const gate = await requireAdmin(Astro);
if (gate) return gate;

const { DB } = env(Astro);

const ref = Astro.url.searchParams.get('ref');
const filterRaw = Astro.url.searchParams.get('status') ?? 'open';
const filter = (['open', 'all', ...VISIT_STATUSES] as string[]).includes(filterRaw) ? filterRaw : 'open';
const saved = Astro.url.searchParams.get('saved') === '1';

let rows: VisitRow[] = [];
let one: VisitRow | null = null;
let dbError: string | null = null;

if (!DB) {
  dbError = 'Gagnagrunnurinn er ekki tengdur.';
} else {
  try {
    if (ref) one = await getVisit(DB, ref);
    rows = await listVisits(DB, { status: filter as VisitStatus | 'open' | 'all' });
  } catch (e) {
    dbError = `Gagnagrunnurinn svarar ekki. (${String(e).slice(0, 100)})`;
  }
}

const STATUS: Record<string, string> = {
  new: 'Ný', quoted: 'Verð sent', scheduled: 'Á dagskrá', done: 'Lokið', cancelled: 'Afturkallað',
};
const ITEM: Record<string, string> = {
  sofa: 'Sófi', rug: 'Teppi', carpet: 'Gólfteppi', stains: 'Blettir',
};

const FILTERS = [
  { v: 'open', l: 'Opið' },
  { v: 'new', l: 'Nýjar' },
  { v: 'scheduled', l: 'Á dagskrá' },
  { v: 'done', l: 'Lokið' },
  { v: 'cancelled', l: 'Afturkallað' },
  { v: 'all', l: 'Allt' },
];

const digits = one?.phone.replace(/[^0-9]/g, '') ?? '';
const schedDate = one?.scheduled_at ? isoDate(one.scheduled_at) : one?.preferred_date ?? '';
const schedTime = one?.scheduled_at ? clock(one.scheduled_at) : '09:00';
---

<Admin title={one ? one.ref : 'Verk'} current="visits">
  <div class="a-wrap">
    {one ? (
      <>
        <header class="a-head">
          <div>
            <h1 class="a-h1">{one.name}</h1>
            <p class="a-sub">{one.ref} · {STATUS[one.status]}</p>
          </div>
          <a class="a-btn a-btn--quiet" href="/admin/visits/">
            <span set:html={ADMIN_ICONS.back} />
            Til baka
          </a>
        </header>

        {saved && <p class="a-msg a-msg--ok">Vistað.</p>}

        <div class="a-card dt">
          <div class="a-acts">
            <a class="a-btn a-btn--plain a-btn--sm" href={`tel:${one.phone}`}>
              <span set:html={ADMIN_ICONS.phone} />
              {formatPhone(one.phone)}
            </a>
            <a class="a-btn a-btn--plain a-btn--sm" href={`https://wa.me/${digits}`} target="_blank" rel="noopener">
              <span set:html={ADMIN_ICONS.whatsapp} />
              WhatsApp
            </a>
            {one.email && (
              <a class="a-btn a-btn--quiet a-btn--sm" href={`mailto:${one.email}`}>
                <span set:html={ADMIN_ICONS.mail} />
                {one.email}
              </a>
            )}
          </div>

          <dl class="dt__facts">
            <div><dt>Óskadagur</dt><dd>{longDate(one.preferred_date, 'is')}</dd></div>
            <div><dt>Tímabil</dt><dd>{one.window === 'morning' ? 'Fyrir hádegi' : one.window === 'afternoon' ? 'Eftir hádegi' : 'Hvort sem er'}</dd></div>
            <div><dt>Verk</dt><dd>{parseItems(one.items).map((i) => ITEM[i] ?? i).join(', ') || '—'}</dd></div>
            <div><dt>Svæði</dt><dd>{one.area ?? '—'}</dd></div>
            <div><dt>Heimilisfang</dt><dd>{one.address ?? '—'}</dd></div>
            <div><dt>Verð</dt><dd>{isk(one.quote_isk)}</dd></div>
          </dl>
        </div>

        <form class="a-card a-form dt__form" method="POST" action="/api/admin/visit">
          <input type="hidden" name="ref" value={one.ref} />

          <div class="a-two">
            <label class="a-field">
              <span class="a-label">Staða</span>
              <select class="a-in" name="status">
                {VISIT_STATUSES.map((st) => (
                  <option value={st} selected={st === one!.status}>{STATUS[st]}</option>
                ))}
              </select>
            </label>

            <label class="a-field">
              <span class="a-label">Verð (ISK)</span>
              <input class="a-in" type="number" inputmode="numeric" name="quote_isk"
                     min="0" step="500" value={one.quote_isk ?? ''} placeholder="—" />
            </label>
          </div>

          <div class="a-two">
            <label class="a-field">
              <span class="a-label">Dagsetning</span>
              <input class="a-in" type="date" name="date" value={schedDate} />
            </label>

            <label class="a-field">
              <span class="a-label">Tími</span>
              <input class="a-in" type="time" name="time" value={schedTime} step="900" />
              <span class="a-hint">Skrifast aðeins þegar staðan er „Á dagskrá“.</span>
            </label>
          </div>

          <label class="a-field">
            <span class="a-label">Heimilisfang</span>
            <input class="a-in" type="text" name="address" value={one.address ?? ''} />
          </label>

          <label class="a-field">
            <span class="a-label">Athugasemdir</span>
            <textarea class="a-in" name="notes" rows="4">{one.notes ?? ''}</textarea>
          </label>

          <div class="a-acts">
            <button class="a-btn a-btn--primary" type="submit">
              <span set:html={ADMIN_ICONS.check} />
              Vista
            </button>
            <a class="a-btn a-btn--quiet" href="/admin/visits/">Hætta við</a>
          </div>
        </form>
      </>
    ) : (
      <>
        <header class="a-head">
          <div>
            <h1 class="a-h1">Verk</h1>
            <p class="a-sub">{rows.length} færslur</p>
          </div>
          <a class="a-btn a-btn--primary" href="/admin/new-visit/">
            <span set:html={ADMIN_ICONS.plus} />
            Nýtt
          </a>
        </header>

        {dbError && <p class="a-msg a-msg--err">{dbError}</p>}
        {saved && <p class="a-msg a-msg--ok">Vistað.</p>}
        {ref && !one && !dbError && <p class="a-msg a-msg--warn">Fann ekki {ref}.</p>}

        <nav class="a-filters" aria-label="Sía">
          {FILTERS.map((f) => (
            <a class="a-filter" href={`/admin/visits/?status=${f.v}`}
               aria-current={f.v === filter ? 'true' : undefined}>{f.l}</a>
          ))}
        </nav>

        <VisitCard rows={rows} empty="Engin verk í þessari síu." />
      </>
    )}
  </div>
</Admin>

<style>
  .dt { display: flex; flex-direction: column; gap: 14px; margin-bottom: 12px; }

  .dt__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 12px;
    padding-top: 13px;
    border-top: 1px solid var(--a-line);
  }

  .dt__facts dt {
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: .05em;
    text-transform: uppercase;
    color: var(--a-ink-3);
    margin-bottom: 2px;
  }

  .dt__facts dd { font-size: 14.5px; color: var(--a-ink); }

  .dt__form { margin-bottom: 20px; }
</style>
