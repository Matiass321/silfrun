---
import Admin from '~/layouts/Admin.astro';
import { requireAdmin, env, EMAIL_KEY } from '~/lib/admin-guard';
import { getSettingOrNull } from '~/lib/auth';
import { SITE, isPlaceholder, whatsappUrl } from '~/config/site';
import { ADMIN_ICONS } from '~/data/admin-icons';

export const prerender = false;

const gate = await requireAdmin(Astro);
if (gate) return gate;

const { DB, ADMIN_SESSION_SECRET, ADMIN_PASSWORD_HASH } = env(Astro);

const saved = Astro.url.searchParams.get('saved') === '1';
const err = Astro.url.searchParams.get('e');
const MESSAGES: Record<string, string> = {
  short: 'Nýja lykilorðið þarf að vera minnst 12 stafir.',
  mismatch: 'Lykilorðin stemma ekki.',
  wrong: 'Núverandi lykilorð er rangt.',
  nodb: 'Gagnagrunnurinn er ekki tengdur.',
};

/* Health checks, so a broken install names the missing piece rather than
   failing somewhere further in with no explanation. */
let dbOk = false;
let dbDetail = 'Ekki tengdur';
if (DB) {
  try {
    await DB.prepare('SELECT 1 FROM settings LIMIT 1').first();
    dbOk = true;
    dbDetail = 'Tengdur';
  } catch {
    dbDetail = 'Tengdur en skema vantar — keyrðu db:migrate:remote';
  }
}

let statsOk = false;
try {
  if (DB) { await DB.prepare('SELECT 1 FROM events LIMIT 1').first(); statsOk = true; }
} catch { /* migration 0001 not applied */ }

const adminEmail = DB ? await getSettingOrNull(DB, EMAIL_KEY) : null;
const passwordInD1 = DB ? Boolean(await getSettingOrNull(DB, 'admin_password_hash')) : false;

let tokens: { token: string; label: string | null; last_used_at: number | null }[] = [];
try {
  if (DB) {
    const r = await DB
      .prepare('SELECT token, label, last_used_at FROM calendar_tokens ORDER BY created_at DESC')
      .all<{ token: string; label: string | null; last_used_at: number | null }>();
    tokens = r.results ?? [];
  }
} catch { /* migration 0001 not applied */ }

const checks = [
  { l: 'Gagnagrunnur', ok: dbOk, d: dbDetail },
  { l: 'Tölfræði', ok: statsOk, d: statsOk ? 'Virk' : 'Færsla 0001 ekki keyrð' },
  { l: 'Lotulykill', ok: Boolean(ADMIN_SESSION_SECRET), d: ADMIN_SESSION_SECRET ? 'Stilltur' : 'Vantar' },
  { l: 'Innskráning', ok: Boolean(adminEmail), d: adminEmail ?? 'Netfang ekki sett' },
  { l: 'Lykilorð', ok: passwordInD1 || Boolean(ADMIN_PASSWORD_HASH), d: passwordInD1 ? 'Geymt' : ADMIN_PASSWORD_HASH ? 'Leyndarmál' : 'Ekki sett' },
  { l: 'WhatsApp', ok: whatsappUrl() !== null, d: whatsappUrl() ? SITE.contact.phone : 'Ekki stillt' },
  { l: 'Netfang vefs', ok: !isPlaceholder(SITE.contact.email), d: isPlaceholder(SITE.contact.email) ? 'Ekki stillt' : String(SITE.contact.email) },
  { l: 'Kennitala', ok: !isPlaceholder(SITE.kennitala), d: isPlaceholder(SITE.kennitala) ? 'VANTAR — lögbundin' : String(SITE.kennitala) },
];

const missing = checks.filter((c) => !c.ok).length;
---

<Admin title="Stillingar">
  <div class="a-wrap se">
    <header class="a-head">
      <div>
        <h1 class="a-h1">Stillingar</h1>
        <p class="a-sub">{missing === 0 ? 'Allt í lagi' : `${missing} atriði þarfnast athygli`}</p>
      </div>
      <a class="a-btn a-btn--quiet" href="/admin/">
        <span set:html={ADMIN_ICONS.back} />
        Til baka
      </a>
    </header>

    {saved && <p class="a-msg a-msg--ok">Vistað.</p>}
    {err && MESSAGES[err] && <p class="a-msg a-msg--err">{MESSAGES[err]}</p>}

    <section class="a-card">
      <h2 class="a-sec__h">Kerfisstaða</h2>
      <ul class="se__checks">
        {checks.map((c) => (
          <li class="se__check">
            <span class:list={['se__dot', c.ok ? 'se__dot--ok' : 'se__dot--no']} aria-hidden="true"></span>
            <span class="se__l">{c.l}</span>
            <span class="se__d">{c.d}</span>
            <span class="a-hide">{c.ok ? 'Í lagi' : 'Vantar'}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="a-card a-sec">
      <h2 class="a-sec__h">Google Calendar</h2>
      <p class="se__note">
        Afritaðu slóðina og límdu hana í Google Calendar undir
        <strong>Önnur dagatöl → Gerast áskrifandi → Frá vefslóð</strong>.
        Bókanir birtast sjálfkrafa. Google sækir uppfærslur á sínum hraða,
        oftast á klukkustundar fresti — þetta er áskrift, ekki lifandi speglun.
      </p>

      {tokens.length === 0 ? (
        <form method="POST" action="/api/admin/calendar-token">
          <button class="a-btn a-btn--primary" type="submit" disabled={!dbOk}>
            <span set:html={ADMIN_ICONS.link} />
            Búa til áskriftarslóð
          </button>
        </form>
      ) : (
        <div class="se__toks">
          {tokens.map((t) => (
            <div class="se__tok">
              <input
                class="a-in se__url"
                type="text"
                readonly
                value={`${SITE.url}/calendar/${t.token}.ics`}
                aria-label="Áskriftarslóð"
              />
              <div class="a-acts">
                <span class="se__used">{t.last_used_at ? 'Sótt af Google' : 'Ekki sótt enn'}</span>
                <form method="POST" action="/api/admin/calendar-token">
                  <input type="hidden" name="action" value="revoke" />
                  <input type="hidden" name="token" value={t.token} />
                  <button class="a-btn a-btn--danger a-btn--sm" type="submit">Afturkalla</button>
                </form>
              </div>
            </div>
          ))}
        </div>
      )}
    </section>

    <section class="a-card a-sec">
      <h2 class="a-sec__h">Breyta lykilorði</h2>
      <form class="a-form" method="POST" action="/api/admin/password">
        <label class="a-field">
          <span class="a-label">Núverandi lykilorð</span>
          <input class="a-in" type="password" name="current" autocomplete="current-password" required />
        </label>
        <div class="a-two">
          <label class="a-field">
            <span class="a-label">Nýtt lykilorð</span>
            <input class="a-in" type="password" name="password" minlength="12" autocomplete="new-password" required />
          </label>
          <label class="a-field">
            <span class="a-label">Endurtaktu</span>
            <input class="a-in" type="password" name="confirm" minlength="12" autocomplete="new-password" required />
          </label>
        </div>
        <div class="a-acts">
          <button class="a-btn a-btn--primary" type="submit" disabled={!dbOk}>Vista lykilorð</button>
        </div>
      </form>
    </section>

    <section class="a-card a-sec">
      <h2 class="a-sec__h">Breytt í kóða</h2>
      <p class="se__note">
        Verð, þjónustusvæði, opnunartími og tengiliðir eru í
        <code>src/config/site.ts</code> — ekki hér. Það er eini staðurinn sem þau
        eru skrifuð, svo vefurinn og byggingin geta ekki orðið ósammála.
      </p>
    </section>

    <form class="se__out" method="POST" action="/api/admin/logout">
      <button class="a-btn a-btn--plain a-btn--block" type="submit">Útskrá</button>
    </form>
  </div>
</Admin>

<style>
  .se__checks { display: flex; flex-direction: column; }

  .se__check {
    display: grid;
    grid-template-columns: 9px 1fr;
    gap: 3px 11px;
    align-items: center;
    padding: 9px 0;
    border-bottom: 1px solid var(--a-line);
  }

  .se__check:last-child { border-bottom: 0; }

  .se__dot { width: 7px; height: 7px; border-radius: 50%; grid-row: 1 / 3; align-self: center; }
  .se__dot--ok { background: var(--a-good); }
  .se__dot--no { background: var(--a-warn); }

  .se__l { font-size: 14.5px; font-weight: 500; }
  .se__d { font-family: var(--a-mono); font-size: 12px; color: var(--a-ink-3); word-break: break-word; }

  .se__note { font-size: 13.5px; color: var(--a-ink-2); line-height: 1.55; margin-bottom: 12px; }
  .se__note code { font-family: var(--a-mono); font-size: 12.5px; color: var(--a-accent); }

  .se__toks { display: flex; flex-direction: column; gap: 12px; }
  .se__tok { display: flex; flex-direction: column; gap: 8px; }
  .se__url { font-family: var(--a-mono); font-size: 12.5px; background: var(--a-inset); }
  .se__used { font-size: 12.5px; color: var(--a-ink-3); }

  .se__out { margin-top: 22px; }
</style>
