---
import Admin from '~/layouts/Admin.astro';
import VisitCard from '~/components/admin/VisitCard.astro';
import { requireAdmin, env } from '~/lib/admin-guard';
import { listVisits, statusCounts, visitsBetween, type VisitRow } from '~/lib/visits';
import { today, addDays, startOfDay, endOfDay, longDate, clock } from '~/lib/time';
import {
  generateTomorrowReminders, pendingReminders, reminderLink, type ReminderRow,
} from '~/lib/reminders';
import { ADMIN_ICONS } from '~/data/admin-icons';

export const prerender = false;

const gate = await requireAdmin(Astro);
if (gate) return gate;

const { DB } = env(Astro);

let counts: Record<string, number> = {};
let todays: VisitRow[] = [];
let tomorrows: VisitRow[] = [];
let fresh: VisitRow[] = [];
let reminders: ReminderRow[] = [];
let dbError: string | null = null;

/**
 * A missing or unmigrated database must not blank the dashboard.
 *
 * The likeliest moment to hit this is the first deploy, before the schema is
 * applied — and a stack trace tells whoever is standing there nothing about
 * what to do next.
 */
if (!DB) {
  dbError = 'The database is not connected.';
} else {
  try {
    const d0 = today();
    const d1 = addDays(d0, 1);

    /* Idempotent through the UNIQUE index, so running it on every load can
       never produce a second message to a customer. */
    await generateTomorrowReminders(DB);

    [counts, todays, tomorrows, fresh, reminders] = await Promise.all([
      statusCounts(DB),
      visitsBetween(DB, startOfDay(d0), endOfDay(d0)),
      visitsBetween(DB, startOfDay(d1), endOfDay(d1)),
      listVisits(DB, { status: 'new', limit: 20 }),
      pendingReminders(DB),
    ]);
  } catch (e) {
    dbError = `The database is not responding. Run "npm run db:migrate:remote". (${String(e).slice(0, 100)})`;
  }
}

const d0 = today();
const open = (counts.new ?? 0) + (counts.quoted ?? 0) + (counts.scheduled ?? 0);
---

<Admin title="Today" current="today">
  <div class="a-wrap">
    <header class="a-head">
      <div>
        <h1 class="a-h1">Today</h1>
        <p class="a-sub">{longDate(d0, 'is')}</p>
      </div>
      <a class="a-btn a-btn--primary" href="/admin/new-visit/">
        <span set:html={ADMIN_ICONS.plus} />
        New job
      </a>
    </header>

    {dbError && <p class="a-msg a-msg--err">{dbError}</p>}

    <div class="a-grid a-grid--2">
      <div class="a-card a-stat">
        <span class="a-stat__n">{todays.length}</span>
        <span class="a-stat__l">Today</span>
      </div>
      <div class="a-card a-stat">
        <span class="a-stat__n">{counts.new ?? 0}</span>
        <span class="a-stat__l">New</span>
      </div>
      <div class="a-card a-stat">
        <span class="a-stat__n">{counts.scheduled ?? 0}</span>
        <span class="a-stat__l">Scheduled</span>
      </div>
      <div class="a-card a-stat">
        <span class="a-stat__n">{open}</span>
        <span class="a-stat__l">Open</span>
      </div>
    </div>

    {reminders.length > 0 && (
      <section class="a-sec">
        <h2 class="a-sec__h">
          Reminders
          <span class="a-badge">{reminders.length}</span>
        </h2>

        <ul class="a-rows">
          {reminders.map((r) => {
            const link = reminderLink(r);
            return (
              <li class="a-card rm">
                <div class="a-row__top">
                  <span class="a-row__name">{r.name ?? '—'}</span>
                  <span class="a-row__mono">
                    {r.subject}{r.scheduled_at ? ` · ${clock(r.scheduled_at)}` : ''}
                  </span>
                </div>

                {/* Shown in full: nobody should press send on text they have not read. */}
                <p class="rm__body">{r.body}</p>

                <div class="a-acts">
                  {link && (
                    <a class="a-btn a-btn--primary a-btn--sm" href={link} target="_blank" rel="noopener">
                      <span set:html={ADMIN_ICONS.whatsapp} />
                      Send
                    </a>
                  )}
                  <form method="POST" action="/api/admin/reminder">
                    <input type="hidden" name="id" value={r.id} />
                    <input type="hidden" name="action" value="sent" />
                    <button class="a-btn a-btn--plain a-btn--sm" type="submit">
                      <span set:html={ADMIN_ICONS.check} />
                      Mark as sent
                    </button>
                  </form>
                  <form method="POST" action="/api/admin/reminder">
                    <input type="hidden" name="id" value={r.id} />
                    <input type="hidden" name="action" value="dismiss" />
                    <button class="a-btn a-btn--quiet a-btn--sm" type="submit">Skip</button>
                  </form>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <section class="a-sec">
      <h2 class="a-sec__h">Today's schedule</h2>
      <VisitCard rows={todays} empty="Nothing booked today." showTime />
    </section>

    <section class="a-sec">
      <h2 class="a-sec__h">Tomorrow</h2>
      <VisitCard rows={tomorrows} empty="Nothing booked tomorrow." showTime />
    </section>

    <section class="a-sec">
      <h2 class="a-sec__h">
        New enquiries
        {fresh.length > 0 && <span class="a-badge">{fresh.length}</span>}
      </h2>
      <VisitCard rows={fresh} empty="No unanswered enquiries." />
    </section>
  </div>
</Admin>

<style>
  .rm { display: flex; flex-direction: column; gap: 10px; }

  .rm__body {
    padding: 11px 13px;
    background: var(--a-inset);
    border-radius: var(--a-r-sm);
    font-size: 14px;
    color: var(--a-ink-2);
    white-space: pre-wrap;
    line-height: 1.55;
  }
</style>
