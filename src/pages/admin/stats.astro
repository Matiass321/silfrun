---
import { ADMIN_ICONS } from '~/data/admin-icons';
import Admin from '~/layouts/Admin.astro';
import Sparkline from '~/components/admin/Sparkline.astro';
import BarList from '~/components/admin/BarList.astro';
import { requireAdmin, env } from '~/lib/admin-guard';
import {
  totals, series, topPages, topReferrers, splitBy, viewsOf,
  type DayCount, type LabelCount,
} from '~/lib/analytics';
import { SLUGS } from '~/i18n/routes';

export const prerender = false;

const gate = await requireAdmin(Astro);
if (gate) return gate;

const { DB } = env(Astro);

const rangeRaw = Number(Astro.url.searchParams.get('d') ?? 30);
const days = [7, 30, 90].includes(rangeRaw) ? rangeRaw : 30;

let t: Record<string, number> = {};
let viewSeries: DayCount[] = [];
let waSeries: DayCount[] = [];
let pages: LabelCount[] = [];
let refs: LabelCount[] = [];
let devices: LabelCount[] = [];
let countries: LabelCount[] = [];
let contactViews = 0;
let quoteViews = 0;
let dbError: string | null = null;

/** Both languages of one page are one question, so they are counted together. */
const quotePaths = [`/is/${SLUGS.quote.is}/`, `/en/${SLUGS.quote.en}/`];
const contactPaths = [`/is/${SLUGS.contact.is}/`, `/en/${SLUGS.contact.en}/`];

if (!DB) {
  dbError = 'The database is not connected.';
} else {
  try {
    [t, viewSeries, waSeries, pages, refs, devices, countries, contactViews, quoteViews] =
      await Promise.all([
        totals(DB, days),
        series(DB, 'view', days),
        series(DB, 'whatsapp', days),
        topPages(DB, days),
        topReferrers(DB, days),
        splitBy(DB, 'device', days),
        splitBy(DB, 'country', days),
        viewsOf(DB, contactPaths, days),
        viewsOf(DB, quotePaths, days),
      ]);
  } catch (e) {
    dbError = `Statistics unavailable. Run the latest migration on the database. (${String(e).slice(0, 90)})`;
  }
}

const views = t.view ?? 0;
const wa = t.whatsapp ?? 0;
const bookings = t.booking ?? 0;
const contacts = wa + (t.messenger ?? 0) + (t.call ?? 0) + (t.email ?? 0);

/**
 * Conversion as a share of views.
 *
 * Views, not visitors: nothing here stores an identifier, so there is no way
 * to count people. The label says "af flettingum" — of page views — rather
 * than implying a per-person rate the data cannot support.
 */
const pct = (n: number) => (views > 0 ? ((n / views) * 100).toFixed(1) : '0.0');

const RANGES = [
  { d: 7, l: '7 dagar' },
  { d: 30, l: '30 dagar' },
  { d: 90, l: '90 dagar' },
];

const PAGE_LABEL: Record<string, string> = {
  [`/is/${SLUGS.quote.is}/`]: 'Request a quote',
  [`/en/${SLUGS.quote.en}/`]: 'Request a quote (EN)',
  [`/is/${SLUGS.contact.is}/`]: 'Hafa samband',
  [`/en/${SLUGS.contact.en}/`]: 'Hafa samband (EN)',
  '/is/': 'Home',
  '/en/': 'Home (EN)',
  [`/is/${SLUGS.sofa.is}/`]: 'Sofa cleaning',
  [`/is/${SLUGS.rug.is}/`]: 'Rug cleaning',
};
/**
 * The reset flow is two steps and the confirm screen is a GET.
 *
 * Wiping the table is not dangerous the way deleting a customer is, but it is
 * irreversible, and the numbers on this page are what somebody uses to decide
 * where to spend money. Worth one deliberate tap.
 */
const confirmingReset = Astro.url.searchParams.get('confirm') === 'reset';
const clearedRaw = Astro.url.searchParams.get('cleared');
const cleared = clearedRaw !== null ? Number(clearedRaw) : null;
---

<Admin title="Stats" current="stats">
  <div class="a-wrap">
    <header class="a-head">
      <div>
        <h1 class="a-h1">Stats</h1>
        <p class="a-sub">Last {days} days</p>
      </div>
    </header>

    <nav class="a-filters" aria-label="Window">
      {RANGES.map((r) => (
        <a class="a-filter" href={`/admin/stats/?d=${r.d}`} aria-current={r.d === days ? 'true' : undefined}>
          {r.l}
        </a>
      ))}
    </nav>

    {dbError && <p class="a-msg a-msg--err">{dbError}</p>}

    {cleared !== null && Number.isFinite(cleared) && (
      <p class="a-msg a-msg--ok">
        Cleared {cleared} {cleared === 1 ? 'event' : 'events'}. Counting starts again from now.
      </p>
    )}

    {!dbError && views === 0 && (
      <p class="a-msg a-msg--info">
        No measurements yet. Numbers start collecting the moment somebody visits
        the site — views are counted with a single pixel, not a script, so
        they work with JavaScript switched off too.
      </p>
    )}

    <div class="a-grid a-grid--2">
      <div class="a-card a-stat">
        <span class="a-stat__n">{views}</span>
        <span class="a-stat__l">Flettingar</span>
      </div>
      <div class="a-card a-stat">
        <span class="a-stat__n">{wa}</span>
        <span class="a-stat__l">WhatsApp</span>
        <span class="a-stat__d">{pct(wa)}% af flettingum</span>
      </div>
      <div class="a-card a-stat">
        <span class="a-stat__n">{contacts}</span>
        <span class="a-stat__l">All contacts</span>
        <span class="a-stat__d">{pct(contacts)}%</span>
      </div>
      <div class="a-card a-stat">
        <span class="a-stat__n">{bookings}</span>
        <span class="a-stat__l">Bookings</span>
        <span class="a-stat__d">{pct(bookings)}%</span>
      </div>
    </div>

    <section class="a-sec">
      <h2 class="a-sec__h">Views per day</h2>
      <div class="a-card">
        <Sparkline data={viewSeries} label="flettingar" />
      </div>
    </section>

    <section class="a-sec">
      <h2 class="a-sec__h">WhatsApp clicks per day</h2>
      <div class="a-card">
        <Sparkline data={waSeries} label="smellir" />
      </div>
    </section>

    <section class="a-sec">
      <h2 class="a-sec__h">The path to an enquiry</h2>
      <div class="a-card fn">
        {[
          { l: 'Flettingar', n: views },
          { l: 'Reached “Request a quote”', n: quoteViews },
          { l: 'Reached “Contact”', n: contactViews },
          { l: 'Clicked a contact channel', n: contacts },
          { l: 'Booking submitted', n: bookings },
        ].map((step) => (
          <div class="fn__step">
            <div class="fn__top">
              <span class="fn__l">{step.l}</span>
              <span class="fn__n">{step.n}</span>
            </div>
            <div class="fn__track">
              <div class="fn__fill" style={`width:${views > 0 ? Math.max((step.n / views) * 100, step.n > 0 ? 1.5 : 0) : 0}%`}></div>
            </div>
          </div>
        ))}
        <p class="fn__note">
          Rates are against views, not individuals — no identifier is
          stored, so people cannot be counted.
        </p>
      </div>
    </section>

    <div class="a-grid a-grid--wide a-sec">
      <div class="a-card">
        <h2 class="a-sec__h">Most-viewed pages</h2>
        <BarList items={pages} labels={PAGE_LABEL} empty="Engar flettingar enn." />
      </div>

      <div class="a-card">
        <h2 class="a-sec__h">Where they came from</h2>
        <BarList items={refs} empty="No external referrals yet." />
      </div>

      <div class="a-card">
        <h2 class="a-sec__h">Devices</h2>
        <BarList
          items={devices}
          labels={{ mobile: 'Phone', desktop: 'Desktop' }}
          empty="No data yet."
        />
      </div>

      <div class="a-card">
        <h2 class="a-sec__h">Countries</h2>
        <BarList items={countries} empty="No data yet." />
      </div>
    </div>

    <p class="a-sub priv">
      No cookie, no IP address and no identifier is stored. That is why
      the site needs no consent banner.
    </p>

    {confirmingReset ? (
      <div class="a-card rs">
        <h2 class="rs__title">Clear all recorded events?</h2>
        <p class="rs__body">
          This deletes every view and every contact click, and the graphs start
          from zero. Jobs, customers and photographs are not touched.
        </p>
        <p class="rs__hint">
          Worth doing once, after the site goes live, so the period when you were
          testing it yourself is not counted as customers.
        </p>
        <form method="POST" action="/api/admin/analytics" class="a-acts">
          <input type="hidden" name="action" value="reset" />
          <button class="a-btn a-btn--danger" type="submit">
            <span set:html={ADMIN_ICONS.trash} />
            Clear the numbers
          </button>
          <a class="a-btn a-btn--quiet" href="/admin/stats/">Keep them</a>
        </form>
      </div>
    ) : (
      <p class="rs__link">
        <a class="a-link-danger" href="/admin/stats/?confirm=reset">Clear recorded events</a>
      </p>
    )}
  </div>
</Admin>

<style>
  .rs { display: flex; flex-direction: column; gap: 14px; margin: 20px 0 28px; }
  .rs__title { font-size: 18px; margin: 0; color: var(--a-ink); }
  .rs__body { font-size: 14.5px; line-height: 1.55; color: var(--a-ink-2); }
  .rs__hint { font-size: 13.5px; color: var(--a-ink-3); }
  .rs__link { margin: 16px 0 28px; text-align: center; }

  .a-link-danger {
    display: inline-block;
    padding: 10px 14px;
    font-size: 13.5px;
    color: var(--a-bad);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .a-link-danger:hover { border-bottom-color: currentColor; }

  .fn { display: flex; flex-direction: column; gap: 12px; }
  .fn__step { display: flex; flex-direction: column; gap: 5px; }
  .fn__top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .fn__l { font-size: 14px; color: var(--a-ink-2); }
  .fn__n { font-family: var(--a-mono); font-size: 13px; color: var(--a-ink); font-variant-numeric: tabular-nums; }
  .fn__track { height: 8px; border-radius: 4px; background: var(--a-sunken); overflow: hidden; }
  .fn__fill { height: 100%; border-radius: 4px; background: var(--a-accent); transition: width .3s ease; }
  .fn__note { margin-top: 4px; font-size: 12.5px; color: var(--a-ink-4); line-height: 1.5; }

  .priv { margin-top: 22px; font-size: 12.5px; line-height: 1.5; }
</style>
