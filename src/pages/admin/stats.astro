---
import { ADMIN_ICONS } from '~/data/admin-icons';
import Admin from '~/layouts/Admin.astro';
import AreaChart from '~/components/admin/AreaChart.astro';
import BarList from '~/components/admin/BarList.astro';
import { requireAdmin, env } from '~/lib/admin-guard';
import {
  totals, series, topPages, splitBy, viewsOf,
  liveVisitors, visitorsSince, visitorsByDay, engagement, todayByKind, hourlyViews, sources,
  type DayCount, type LabelCount, type Source,
} from '~/lib/analytics';
import { SLUGS } from '~/i18n/routes';

export const prerender = false;

const gate = await requireAdmin(Astro);
if (gate) return gate;

const { DB } = env(Astro);

const rangeRaw = Number(Astro.url.searchParams.get('d') ?? 30);
const days = [7, 30, 90].includes(rangeRaw) ? rangeRaw : 30;

let t: Record<string, number> = {};
let viewSeries: DayCount[] = [];
let waSeries: DayCount[] = [];
let pages: LabelCount[] = [];
let srcs: Source[] = [];
let live = 0;
let today: Record<string, number> = {};
let hourly: { hour: string; n: number }[] = [];
let visitorSeries: DayCount[] = [];
let visitors24 = 0;
let eng = { visitors: 0, bounceRate: 0, avgSeconds: 0, viewsPerVisitor: 0 };
let devices: LabelCount[] = [];
let countries: LabelCount[] = [];
let contactViews = 0;
let quoteViews = 0;
let dbError: string | null = null;

/** Both languages of one page are one question, so they are counted together. */
const quotePaths = [`/is/${SLUGS.quote.is}/`, `/en/${SLUGS.quote.en}/`];
const contactPaths = [`/is/${SLUGS.contact.is}/`, `/en/${SLUGS.contact.en}/`];

if (!DB) {
  dbError = 'The database is not connected.';
} else {
  try {
    [t, viewSeries, waSeries, pages, srcs, devices, countries, contactViews, quoteViews,
     live, today, hourly, visitorSeries, visitors24, eng] =
      await Promise.all([
        totals(DB, days),
        series(DB, 'view', days),
        series(DB, 'whatsapp', days),
        topPages(DB, days),
        sources(DB, days),
        splitBy(DB, 'device', days),
        splitBy(DB, 'country', days),
        viewsOf(DB, contactPaths, days),
        viewsOf(DB, quotePaths, days),
        liveVisitors(DB, 5),
        todayByKind(DB),
        hourlyViews(DB, 24),
        visitorsByDay(DB, days),
        visitorsSince(DB, 24),
        engagement(DB, days),
      ]);
  } catch (e) {
    dbError = `Statistics unavailable. Run the latest migration on the database. (${String(e).slice(0, 90)})`;
  }
}

const views = t.view ?? 0;
const wa = t.whatsapp ?? 0;
const bookings = t.booking ?? 0;
const contacts = wa + (t.messenger ?? 0) + (t.call ?? 0) + (t.email ?? 0);

/**
 * Conversion as a share of views.
 *
 * Views, not visitors: nothing here stores an identifier, so there is no way
 * to count people. The label says "af flettingum" — of page views — rather
 * than implying a per-person rate the data cannot support.
 */
const pct = (n: number) => (views > 0 ? ((n / views) * 100).toFixed(1) : '0.0');

const calls = t.call ?? 0;
const emails = t.email ?? 0;
const messenger = t.messenger ?? 0;

/* The charts want a { label, n } shape; the series give { day, n }. */
const asPoints = (rows: DayCount[]) => rows.map((r) => ({ label: r.day.slice(5).replace('-', '.'), n: r.n }));
const hourPoints = hourly.map((h) => ({ label: h.hour.slice(11) + ':00', n: h.n }));

/** Views today, for the headline number. */
const todayViews = today.view ?? 0;

/* Daily uniques, summed. Not COUNT(DISTINCT) over the range — see the note on
   visitorsByDay: the salt rotates nightly, so that would count visits. */
const visitorTotal = visitorSeries.reduce((n, d) => n + d.n, 0);
const visitorsToday = visitorSeries[visitorSeries.length - 1]?.n ?? 0;

const mmss = (secs: number) =>
  secs > 0 ? `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}` : '—';

/* Rates are per visitor now that visitors are real; that is the number a
   person means when they ask what share of people got in touch. */
const perVisitor = (n: number) =>
  eng.visitors > 0 ? ((n / eng.visitors) * 100).toFixed(1) : '0.0';

const CHANNELS = [
  { l: 'WhatsApp', n: wa },
  { l: 'Phone', n: calls },
  { l: 'Email', n: emails },
  { l: 'Messenger', n: messenger },
].filter((c) => c.n > 0 || c.l !== 'Messenger');

const RANGES = [
  { d: 7, l: '7 days' },
  { d: 30, l: '30 days' },
  { d: 90, l: '90 days' },
];

const PAGE_LABEL: Record<string, string> = {
  [`/is/${SLUGS.quote.is}/`]: 'Request a quote',
  [`/en/${SLUGS.quote.en}/`]: 'Request a quote (EN)',
  [`/is/${SLUGS.contact.is}/`]: 'Contact',
  [`/en/${SLUGS.contact.en}/`]: 'Contact (EN)',
  '/is/': 'Home',
  '/en/': 'Home (EN)',
  [`/is/${SLUGS.sofa.is}/`]: 'Sofa cleaning',
  [`/is/${SLUGS.rug.is}/`]: 'Rug cleaning',
};
/**
 * The reset flow is two steps and the confirm screen is a GET.
 *
 * Wiping the table is not dangerous the way deleting a customer is, but it is
 * irreversible, and the numbers on this page are what somebody uses to decide
 * where to spend money. Worth one deliberate tap.
 */
const confirmingReset = Astro.url.searchParams.get('confirm') === 'reset';
const clearedRaw = Astro.url.searchParams.get('cleared');
const cleared = clearedRaw !== null ? Number(clearedRaw) : null;
---

<Admin title="Stats" current="stats">
  <div class="a-wrap">
    <header class="a-head">
      <div>
        <h1 class="a-h1">Stats</h1>
        <p class="a-sub">Last {days} days</p>
      </div>
    </header>

    <nav class="a-filters" aria-label="Window">
      {RANGES.map((r) => (
        <a class="a-filter" href={`/admin/stats/?d=${r.d}`} aria-current={r.d === days ? 'true' : undefined}>
          {r.l}
        </a>
      ))}
    </nav>

    {dbError && <p class="a-msg a-msg--err">{dbError}</p>}

    {cleared !== null && Number.isFinite(cleared) && (
      <p class="a-msg a-msg--ok">
        Cleared {cleared} {cleared === 1 ? 'event' : 'events'}. Counting starts again from now.
      </p>
    )}

    {!dbError && views === 0 && (
      <p class="a-msg a-msg--info">
        No measurements yet. Numbers start collecting the moment somebody visits
        the site — views are counted with a single pixel, not a script, so
        they work with JavaScript switched off too.
      </p>
    )}

    <div class="a-grid a-grid--2">
      <div class="a-card a-stat a-stat--live">
        <span class="a-stat__n">
          {live > 0 && <span class="pulse" aria-hidden="true"></span>}{live}
        </span>
        <span class="a-stat__l">People on the site</span>
        <span class="a-stat__d">right now</span>
      </div>
      <div class="a-card a-stat">
        <span class="a-stat__n">{visitors24}</span>
        <span class="a-stat__l">Visitors</span>
        <span class="a-stat__d">last 24 hours</span>
      </div>
      <div class="a-card a-stat">
        <span class="a-stat__n">{visitorsToday}</span>
        <span class="a-stat__l">Visitors today</span>
        <span class="a-stat__d">{todayViews} views</span>
      </div>
      <div class="a-card a-stat">
        <span class="a-stat__n">{visitorTotal}</span>
        <span class="a-stat__l">Visitors</span>
        <span class="a-stat__d">last {days} days · {views} views</span>
      </div>
    </div>

    <div class="a-grid a-grid--2 a-sec">
      <div class="a-card a-stat">
        <span class="a-stat__n">{mmss(eng.avgSeconds)}</span>
        <span class="a-stat__l">Avg time on site</span>
        <span class="a-stat__d">visitors who saw 2+ pages</span>
      </div>
      <div class="a-card a-stat">
        <span class="a-stat__n">{eng.bounceRate}%</span>
        <span class="a-stat__l">Bounce rate</span>
        <span class="a-stat__d">left after one page</span>
      </div>
      <div class="a-card a-stat">
        <span class="a-stat__n">{eng.viewsPerVisitor}</span>
        <span class="a-stat__l">Pages per visitor</span>
      </div>
      <div class="a-card a-stat">
        <span class="a-stat__n">{contacts}</span>
        <span class="a-stat__l">Contacts</span>
        <span class="a-stat__d">{perVisitor(contacts)}% of visitors</span>
      </div>
    </div>

    {/* Every channel, each with its own number — "all contacts" hides which
        one people actually reach for, which is the thing worth knowing. */}
    <div class="a-grid a-grid--2 a-sec">
      {CHANNELS.map((ch) => (
        <div class="a-card a-stat">
          <span class="a-stat__n">{ch.n}</span>
          <span class="a-stat__l">{ch.l}</span>
          <span class="a-stat__d">{perVisitor(ch.n)}% of visitors</span>
        </div>
      ))}
      <div class="a-card a-stat">
        <span class="a-stat__n">{bookings}</span>
        <span class="a-stat__l">Bookings</span>
        <span class="a-stat__d">{perVisitor(bookings)}% of visitors</span>
      </div>
    </div>

    <section class="a-sec">
      <h2 class="a-sec__h">Last 24 hours</h2>
      <div class="a-card">
        <AreaChart data={hourPoints} title="Views per hour, last 24 hours" height={170} ticks={4} />
      </div>
    </section>

    <section class="a-sec">
      <h2 class="a-sec__h">Visitors per day</h2>
      <div class="a-card">
        <AreaChart
          data={asPoints(visitorSeries)}
          compare={asPoints(viewSeries)}
          compareLabel="views"
          title="Visitors per day"
          height={230}
        />
      </div>
    </section>

    <section class="a-sec">
      <h2 class="a-sec__h">WhatsApp clicks per day</h2>
      <div class="a-card">
        <AreaChart data={asPoints(waSeries)} title="WhatsApp clicks per day" height={150} />
      </div>
    </section>

    <section class="a-sec">
      <h2 class="a-sec__h">The path to an enquiry</h2>
      <div class="a-card fn">
        {[
          { l: 'Visitors', n: eng.visitors },
          { l: 'Reached “Request a quote”', n: quoteViews },
          { l: 'Reached “Contact”', n: contactViews },
          { l: 'Clicked a contact channel', n: contacts },
          { l: 'Booking submitted', n: bookings },
        ].map((step) => (
          <div class="fn__step">
            <div class="fn__top">
              <span class="fn__l">{step.l}</span>
              <span class="fn__n">{step.n}</span>
            </div>
            <div class="fn__track">
              <div class="fn__fill" style={`width:${eng.visitors > 0 ? Math.min(Math.max((step.n / eng.visitors) * 100, step.n > 0 ? 1.5 : 0), 100) : 0}%`}></div>
            </div>
          </div>
        ))}
        <p class="fn__note">
          Visitors are counted with a hash of the IP address and a salt that is
          regenerated every day and deleted after two. No IP is stored and no
          cookie is set, so a person is countable today and unlinkable
          tomorrow — which also means someone returning next week counts as a
          new visitor.
        </p>
      </div>
    </section>

    <div class="a-grid a-grid--wide a-sec">
      <div class="a-card">
        <h2 class="a-sec__h">Most-viewed pages</h2>
        <BarList items={pages} labels={PAGE_LABEL} empty="No views yet." />
      </div>

      <div class="a-card">
        <h2 class="a-sec__h">Where they came from</h2>
        <BarList
          items={srcs.map((s) => ({ label: s.label, n: s.n }))}
          empty="No traffic recorded yet."
        />
        <p class="src__note">
          Direct covers a typed address and any app that strips the referrer.
        </p>
      </div>

      <div class="a-card">
        <h2 class="a-sec__h">Devices</h2>
        <BarList
          items={devices}
          labels={{ mobile: 'Phone', desktop: 'Desktop' }}
          empty="No data yet."
        />
      </div>

      <div class="a-card">
        <h2 class="a-sec__h">Countries</h2>
        <BarList items={countries} empty="No data yet." />
      </div>
    </div>

    <p class="a-sub priv">
      No cookie is set and no IP address is stored. Visitors are counted by a
      hash of the IP with a salt that rotates daily and is deleted after two
      days, so the count is real today and cannot be reconstructed later.
    </p>

    {confirmingReset ? (
      <div class="a-card rs">
        <h2 class="rs__title">Clear all recorded events?</h2>
        <p class="rs__body">
          This deletes every view and every contact click, and the graphs start
          from zero. Jobs, customers and photographs are not touched.
        </p>
        <p class="rs__hint">
          Worth doing once, after the site goes live, so the period when you were
          testing it yourself is not counted as customers.
        </p>
        <form method="POST" action="/api/admin/analytics" class="a-acts">
          <input type="hidden" name="action" value="reset" />
          <button class="a-btn a-btn--danger" type="submit">
            <span set:html={ADMIN_ICONS.trash} />
            Clear the numbers
          </button>
          <a class="a-btn a-btn--quiet" href="/admin/stats/">Keep them</a>
        </form>
      </div>
    ) : (
      <p class="rs__link">
        <a class="a-link-danger" href="/admin/stats/?confirm=reset">Clear recorded events</a>
      </p>
    )}
  </div>
</Admin>

<style>
  .a-stat--live .a-stat__n { display: flex; align-items: center; gap: 8px; }

  .pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--a-good);
    box-shadow: 0 0 0 0 var(--a-good);
    animation: pulse 2s ease-out infinite;
  }

  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 rgba(23, 80, 62, .45); }
    70%  { box-shadow: 0 0 0 9px rgba(23, 80, 62, 0); }
    100% { box-shadow: 0 0 0 0 rgba(23, 80, 62, 0); }
  }

  @media (prefers-reduced-motion: reduce) { .pulse { animation: none; } }

  .src__note { margin-top: 10px; font-size: 12px; color: var(--a-ink-3); }

  .rs { display: flex; flex-direction: column; gap: 14px; margin: 20px 0 28px; }
  .rs__title { font-size: 18px; margin: 0; color: var(--a-ink); }
  .rs__body { font-size: 14.5px; line-height: 1.55; color: var(--a-ink-2); }
  .rs__hint { font-size: 13.5px; color: var(--a-ink-3); }
  .rs__link { margin: 16px 0 28px; text-align: center; }

  .a-link-danger {
    display: inline-block;
    padding: 10px 14px;
    font-size: 13.5px;
    color: var(--a-bad);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .a-link-danger:hover { border-bottom-color: currentColor; }

  .fn { display: flex; flex-direction: column; gap: 12px; }
  .fn__step { display: flex; flex-direction: column; gap: 5px; }
  .fn__top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .fn__l { font-size: 14px; color: var(--a-ink-2); }
  .fn__n { font-family: var(--a-mono); font-size: 13px; color: var(--a-ink); font-variant-numeric: tabular-nums; }
  .fn__track { height: 8px; border-radius: 4px; background: var(--a-sunken); overflow: hidden; }
  .fn__fill { height: 100%; border-radius: 4px; background: var(--a-accent); transition: width .3s ease; }
  .fn__note { margin-top: 4px; font-size: 12.5px; color: var(--a-ink-4); line-height: 1.5; }

  .priv { margin-top: 22px; font-size: 12.5px; line-height: 1.5; }
</style>
