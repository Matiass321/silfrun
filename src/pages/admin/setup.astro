---
import Admin from '~/layouts/Admin.astro';
import { env, resolvePasswordHash } from '~/lib/admin-guard';

export const prerender = false;

const { DB, ADMIN_PASSWORD_HASH, ADMIN_SESSION_SECRET } = env(Astro);

/**
 * First run only.
 *
 * Once a password exists this page closes for good — otherwise it is an
 * unauthenticated endpoint that overwrites the admin password, which is the
 * entire security model given away. Changing it later goes through Stillingar,
 * behind the session and the current password.
 */
const existing = await resolvePasswordHash(DB, ADMIN_PASSWORD_HASH);
if (existing) return Astro.redirect('/admin/login/', 302);

const ready = Boolean(DB) && Boolean(ADMIN_SESSION_SECRET);

const err = Astro.url.searchParams.get('e');
const MESSAGES: Record<string, string> = {
  email: 'Sláðu inn gilt netfang.',
  short: 'Lykilorðið þarf að vera minnst 12 stafir.',
  mismatch: 'Lykilorðin stemma ekki.',
  taken: 'Lykilorð hefur þegar verið sett.',
  nodb: 'Gagnagrunnurinn er ekki tengdur.',
};
---

<Admin title="Uppsetning" bare>
  <div class="st">
    <h1 class="st__h">Uppsetning</h1>
    <p class="st__lead">
      Veldu netfang og lykilorð. Lykilorðið er geymt sem PBKDF2-hash — aldrei
      sem texti — og þessi síða lokast varanlega á eftir.
    </p>

    {!DB && <p class="a-msg a-msg--err">Gagnagrunnurinn er ekki tengdur.</p>}
    {!ADMIN_SESSION_SECRET && <p class="a-msg a-msg--err">ADMIN_SESSION_SECRET vantar.</p>}
    {err && MESSAGES[err] && <p class="a-msg a-msg--err">{MESSAGES[err]}</p>}

    <form class="a-form" method="POST" action="/api/admin/setup">
      <label class="a-field">
        <span class="a-label">Netfang</span>
        <input class="a-in" type="email" name="email" autocomplete="username" required disabled={!ready} />
        <span class="a-hint">Notað til að skrá inn. Birtist hvergi á vefnum.</span>
      </label>

      <label class="a-field">
        <span class="a-label">Lykilorð</span>
        <input class="a-in" type="password" name="password" minlength="12"
               autocomplete="new-password" required disabled={!ready} />
        <span class="a-hint">Minnst 12 stafir. Notaðu lykilorðastjóra.</span>
      </label>

      <label class="a-field">
        <span class="a-label">Endurtaktu lykilorðið</span>
        <input class="a-in" type="password" name="confirm" minlength="12"
               autocomplete="new-password" required disabled={!ready} />
      </label>

      <button class="a-btn a-btn--primary a-btn--block" type="submit" disabled={!ready}>
        Vista og skrá inn
      </button>
    </form>
  </div>
</Admin>

<style>
  .st { width: 100%; max-width: 400px; display: flex; flex-direction: column; gap: 14px; }
  .st__h { font-size: 22px; font-weight: 600; }
  .st__lead { font-size: 14px; color: var(--a-ink-2); line-height: 1.55; }
</style>
