---
import Admin from '~/layouts/Admin.astro';
import { requireAdmin, env } from '~/lib/admin-guard';
import { SITE } from '~/config/site';
import { today } from '~/lib/time';
import { ADMIN_ICONS } from '~/data/admin-icons';

export const prerender = false;

const gate = await requireAdmin(Astro);
if (gate) return gate;

const { DB } = env(Astro);

const err = Astro.url.searchParams.get('e');
const MESSAGES: Record<string, string> = {
  name: 'Nafn vantar.',
  phone: 'Símanúmer vantar.',
  date: 'Dagsetning vantar.',
  nodb: 'Gagnagrunnurinn er ekki tengdur.',
};

const SERVICES = [
  { key: 'sofa', label: 'Sófi og áklæði' },
  { key: 'rug', label: 'Teppi' },
  { key: 'carpet', label: 'Gólfteppi' },
  { key: 'stains', label: 'Blettir og lykt' },
];
---

<Admin title="Nýtt verk" current="visits">
  <div class="a-wrap nv">
    <header class="a-head">
      <div>
        <h1 class="a-h1">Nýtt verk</h1>
        <p class="a-sub">Skráð eftir símtal eða WhatsApp.</p>
      </div>
      <a class="a-btn a-btn--quiet" href="/admin/visits/">
        <span set:html={ADMIN_ICONS.back} />
        Til baka
      </a>
    </header>

    {!DB && <p class="a-msg a-msg--err">Gagnagrunnurinn er ekki tengdur.</p>}
    {err && MESSAGES[err] && <p class="a-msg a-msg--err">{MESSAGES[err]}</p>}

    <form class="a-card a-form" method="POST" action="/api/admin/new-visit">
      <fieldset class="a-fs">
        <legend class="a-legend">Viðskiptavinur</legend>
        <div class="a-two">
          <label class="a-field">
            <span class="a-label">Nafn <span class="a-req">*</span></span>
            <input class="a-in" type="text" name="name" required autocomplete="off" />
          </label>
          <label class="a-field">
            <span class="a-label">Sími <span class="a-req">*</span></span>
            <input class="a-in" type="tel" inputmode="tel" name="phone" required
                   placeholder="771 3011" autocomplete="off" />
          </label>
        </div>
        <div class="a-two">
          <label class="a-field">
            <span class="a-label">Netfang</span>
            <input class="a-in" type="email" inputmode="email" name="email" autocomplete="off" />
          </label>
          <label class="a-field">
            <span class="a-label">Svæði</span>
            <select class="a-in" name="area">
              <option value="">—</option>
              {SITE.areas.map((a) => <option value={a.name}>{a.name}</option>)}
            </select>
          </label>
        </div>
      </fieldset>

      <fieldset class="a-fs">
        <legend class="a-legend">Verkið</legend>
        <div class="nv__items">
          {SERVICES.map((s) => (
            <label class="a-check">
              <input type="checkbox" name="items" value={s.key} />
              <span>{s.label}</span>
            </label>
          ))}
        </div>
        <label class="a-field">
          <span class="a-label">Heimilisfang</span>
          <input class="a-in" type="text" name="address" autocomplete="off" />
        </label>
      </fieldset>

      <fieldset class="a-fs">
        <legend class="a-legend">Tími</legend>
        <div class="a-two">
          <label class="a-field">
            <span class="a-label">Óskadagur <span class="a-req">*</span></span>
            <input class="a-in" type="date" name="preferred_date" required value={today()} />
          </label>
          <label class="a-field">
            <span class="a-label">Tímabil</span>
            <select class="a-in" name="window">
              <option value="morning">Fyrir hádegi</option>
              <option value="afternoon">Eftir hádegi</option>
              <option value="either">Hvort sem er</option>
            </select>
          </label>
        </div>
      </fieldset>

      <label class="a-field">
        <span class="a-label">Athugasemdir</span>
        <textarea class="a-in" name="notes" rows="4"
                  placeholder="Efni, blettir, aðgengi, bílastæði…"></textarea>
      </label>

      <div class="a-acts">
        <button class="a-btn a-btn--primary" type="submit" disabled={!DB}>
          <span set:html={ADMIN_ICONS.check} />
          Skrá verk
        </button>
        <a class="a-btn a-btn--quiet" href="/admin/visits/">Hætta við</a>
      </div>
    </form>
  </div>
</Admin>

<style>
  .nv .a-wrap { max-width: 720px; }
  .nv__items { display: grid; grid-template-columns: 1fr; gap: 8px; }
  @media (min-width: 40rem) { .nv__items { grid-template-columns: 1fr 1fr; } }
</style>
