---
import Admin from '~/layouts/Admin.astro';
import { requireAdmin, env } from '~/lib/admin-guard';
import { SITE } from '~/config/site';
import { today } from '~/lib/time';
import { ADMIN_ICONS } from '~/data/admin-icons';

export const prerender = false;

const gate = await requireAdmin(Astro);
if (gate) return gate;

const { DB } = env(Astro);

const err = Astro.url.searchParams.get('e');
const MESSAGES: Record<string, string> = {
  name: 'Name is missing.',
  phone: 'Phone number missing.',
  date: 'Date is missing.',
  nodb: 'The database is not connected.',
};

const SERVICES = [
  { key: 'sofa', label: 'Sofa and upholstery' },
  { key: 'rug', label: 'Rug' },
  { key: 'carpet', label: 'Carpet' },
  { key: 'stains', label: 'Stains and odour' },
];
---

<Admin title="New job" current="visits">
  <div class="a-wrap nv">
    <header class="a-head">
      <div>
        <h1 class="a-h1">New job</h1>
        <p class="a-sub">Recorded after a phone call or WhatsApp.</p>
      </div>
      <a class="a-btn a-btn--quiet" href="/admin/visits/">
        <span set:html={ADMIN_ICONS.back} />
        Back
      </a>
    </header>

    {!DB && <p class="a-msg a-msg--err">The database is not connected.</p>}
    {err && MESSAGES[err] && <p class="a-msg a-msg--err">{MESSAGES[err]}</p>}

    <form class="a-card a-form" method="POST" action="/api/admin/new-visit">
      <fieldset class="a-fs">
        <legend class="a-legend">Customer</legend>
        <div class="a-two">
          <label class="a-field">
            <span class="a-label">Name <span class="a-req">*</span></span>
            <input class="a-in" type="text" name="name" required autocomplete="off" />
          </label>
          <label class="a-field">
            <span class="a-label">Phone <span class="a-req">*</span></span>
            <input class="a-in" type="tel" inputmode="tel" name="phone" required
                   placeholder="771 3011" autocomplete="off" />
          </label>
        </div>
        <div class="a-two">
          <label class="a-field">
            <span class="a-label">Email address</span>
            <input class="a-in" type="email" inputmode="email" name="email" autocomplete="off" />
          </label>
          <label class="a-field">
            <span class="a-label">Area</span>
            <select class="a-in" name="area">
              <option value="">—</option>
              {SITE.areas.map((a) => <option value={a.name}>{a.name}</option>)}
            </select>
          </label>
        </div>
      </fieldset>

      <fieldset class="a-fs">
        <legend class="a-legend">The job</legend>
        <div class="nv__items">
          {SERVICES.map((s) => (
            <label class="a-check">
              <input type="checkbox" name="items" value={s.key} />
              <span>{s.label}</span>
            </label>
          ))}
        </div>
        <label class="a-field">
          <span class="a-label">Address</span>
          <input class="a-in" type="text" name="address" autocomplete="off" />
        </label>
      </fieldset>

      <fieldset class="a-fs">
        <legend class="a-legend">Time</legend>
        <div class="a-two">
          <label class="a-field">
            <span class="a-label">Preferred day <span class="a-req">*</span></span>
            <input class="a-in" type="date" name="preferred_date" required value={today()} />
          </label>
          <label class="a-field">
            <span class="a-label">Window</span>
            <select class="a-in" name="window">
              <option value="morning">Morning</option>
              <option value="afternoon">Afternoon</option>
              <option value="either">Either</option>
            </select>
          </label>
        </div>
      </fieldset>

      <label class="a-field">
        <span class="a-label">Notes</span>
        <textarea class="a-in" name="notes" rows="4"
                  placeholder="Material, stains, access, parking…"></textarea>
      </label>

      <div class="a-acts">
        <button class="a-btn a-btn--primary" type="submit" disabled={!DB}>
          <span set:html={ADMIN_ICONS.check} />
          Record job
        </button>
        <a class="a-btn a-btn--quiet" href="/admin/visits/">Cancel</a>
      </div>
    </form>
  </div>
</Admin>

<style>
  .nv .a-wrap { max-width: 720px; }
  .nv__items { display: grid; grid-template-columns: 1fr; gap: 8px; }
  @media (min-width: 40rem) { .nv__items { grid-template-columns: 1fr 1fr; } }
</style>
