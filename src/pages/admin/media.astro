---
import Admin from '~/layouts/Admin.astro';
import { requireAdmin, env } from '~/lib/admin-guard';
import { listAll, SLOTS, mediaUrl, slotMeta, type MediaRow } from '~/lib/media';
import { ADMIN_ICONS } from '~/data/admin-icons';

export const prerender = false;

const gate = await requireAdmin(Astro);
if (gate) return gate;

const { DB } = env(Astro);

const saved = Astro.url.searchParams.get('saved') === '1';
const err = Astro.url.searchParams.get('e');
const editing = Number(Astro.url.searchParams.get('edit')) || null;

const MESSAGES: Record<string, string> = {
  nofile: 'No file selected.',
  type: 'That file type is not supported. Use JPEG, PNG, WebP, AVIF, MP4 or WebM.',
  big: 'That file is too large. The maximum is 25 MB.',
  dupe: 'That file is already in the library.',
  alt: 'Images shown on the website must have Icelandic alt text.',
  nokv: 'The media store is not connected.',
  bad: 'Invalid request.',
};

let items: MediaRow[] = [];
let dbError: string | null = null;

if (!DB) {
  dbError = 'The database is not connected.';
} else {
  try {
    items = await listAll(DB);
  } catch (e) {
    dbError = `The media library is not ready. Run migration 0002. (${String(e).slice(0, 90)})`;
  }
}

const totalMb = (items.reduce((n, m) => n + m.bytes, 0) / 1048576).toFixed(1);
const current = editing ? items.find((m) => m.id === editing) : null;

/**
 * The page is organised by SLOT, not by file.
 *
 * The library was a flat grid of thumbnails and the slots were a separate
 * to-do list of names, so the one question somebody actually has — what is on
 * my website right now, and where — could only be answered by opening every
 * photograph in turn. Every frame the site can show is listed here with its
 * contents in it.
 */
const bySlotKey = new Map<string, MediaRow[]>();
for (const m of items) {
  if (!m.slot) continue;
  const list = bySlotKey.get(m.slot) ?? [];
  list.push(m);
  bySlotKey.set(m.slot, list);
}
for (const list of bySlotKey.values()) list.sort((a, b) => a.position - b.position || a.id - b.id);

const slotsFilled = SLOTS.filter((sl) => (bySlotKey.get(sl.key)?.length ?? 0) > 0).length;
const unplaced = items.filter((m) => !m.slot);

/** Which slots each file sits in, so the library can say so on the thumbnail. */
const placementsOf = (key: string) =>
  items.filter((m) => m.key === key && m.slot).map((m) => slotMeta(m.slot!)?.label ?? m.slot!);

/** Highlight the slot just changed, so a save is visibly attached to a place. */
const justSaved = Astro.url.searchParams.get('slot');

/** A photo needing alt text is a real to-do; count it where it can be seen. */
const missingAlt = items.filter((m) => m.slot && !m.alt_is).length;

const kb = (n: number) => (n > 1048576 ? (n / 1048576).toFixed(1) + ' MB' : Math.round(n / 1024) + ' kB');
---

<Admin title="Photos" current="media">
  <div class="a-wrap">
    <header class="a-head">
      <div>
        <h1 class="a-h1">Photos</h1>
        <p class="a-sub">
          {slotsFilled} of {SLOTS.length} places filled · {items.length} files · {totalMb} MB
          {missingAlt > 0 && <> · <strong class="md__warn">{missingAlt} missing alt text</strong></>}
        </p>
      </div>
    </header>

    {dbError && <p class="a-msg a-msg--err">{dbError}</p>}
    {saved && <p class="a-msg a-msg--ok">Saved.</p>}
    {err && MESSAGES[err] && <p class="a-msg a-msg--err">{MESSAGES[err]}</p>}

    {/* ── Upload ──────────────────────────────────────────────────── */}
    <section class="a-card md__up">
      <h2 class="a-sec__h" style="margin-top:0">Upload</h2>

      <form method="POST" action="/api/admin/media" enctype="multipart/form-data" class="a-form">
        <input type="hidden" name="action" value="upload" />

        {/*
          capture is deliberately NOT set. On a phone, omitting it lets the
          system offer both the camera and the library; setting capture forces
          the camera and hides every photograph already taken.
        */}
        <label class="md__drop">
          <input class="md__file" type="file" name="file"
                 accept="image/jpeg,image/png,image/webp,image/avif,video/mp4,video/webm"
                 required />
          <span class="md__dropicon" set:html={ADMIN_ICONS.plus} />
          <span class="md__droptext">Choose a photo or video</span>
          <span class="md__drophint">JPEG · PNG · WebP · AVIF · MP4 · WebM — 25 MB maximum</span>
        </label>

        <button class="a-btn a-btn--primary" type="submit" disabled={!DB}>Upload</button>
      </form>
    </section>

    {/* ── Editing one item ────────────────────────────────────────── */}
    {current && (
      <section class="a-card md__edit">
        <div class="a-row__top">
          <h2 class="a-sec__h" style="margin:0">Edit</h2>
          <a class="a-btn a-btn--quiet a-btn--sm" href="/admin/media/">Close</a>
        </div>

        <div class="md__editgrid">
          <div class="md__preview">
            {current.kind === 'video' ? (
              <video src={mediaUrl(current.key)} muted loop playsinline controls></video>
            ) : (
              <img src={mediaUrl(current.key)} alt={current.alt_is ?? ''} />
            )}
            <p class="md__meta">
              {current.width && current.height ? `${current.width}×${current.height} · ` : ''}
              {kb(current.bytes)} · {current.mime}
            </p>
          </div>

          <form class="a-form" method="POST" action="/api/admin/media">
            <input type="hidden" name="action" value="update" />
            <input type="hidden" name="id" value={current.id} />

            <label class="a-field">
              <span class="a-label">Where it appears</span>
              <select class="a-in" name="slot">
                <option value="">Nowhere — library only</option>
                {SLOTS.filter((s) => s.kinds.includes(current.kind)).map((s) => (
                  <option value={s.key} selected={s.key === current.slot}>{s.label}</option>
                ))}
              </select>
            </label>

            <label class="a-field">
              <span class="a-label">Alt text (Icelandic) <span class="a-req">*</span></span>
              <input class="a-in" type="text" name="alt_is" value={current.alt_is ?? ''}
                     placeholder="Three-seat wool sofa, dark along the front edge of the cushion" />
              <span class="a-hint">
                Required for any image that appears on the site. Describe what is visible, not “photo of a sofa”.
              </span>
            </label>

            <label class="a-field">
              <span class="a-label">Alt text (English)</span>
              <input class="a-in" type="text" name="alt_en" value={current.alt_en ?? ''} />
            </label>

            <div class="a-two">
              <label class="a-field">
                <span class="a-label">Caption (IS)</span>
                <input class="a-in" type="text" name="caption_is" value={current.caption_is ?? ''} />
              </label>
              <label class="a-field">
                <span class="a-label">Caption (EN)</span>
                <input class="a-in" type="text" name="caption_en" value={current.caption_en ?? ''} />
              </label>
            </div>

            <div class="a-two">
              <label class="a-field">
                <span class="a-label">Before or after</span>
                <select class="a-in" name="pair_role">
                  <option value="">—</option>
                  <option value="before" selected={current.pair_role === 'before'}>Before</option>
                  <option value="after" selected={current.pair_role === 'after'}>After</option>
                </select>
              </label>
              <label class="a-field">
                <span class="a-label">Order</span>
                <input class="a-in" type="number" name="position" min="0" value={current.position} />
                <span class="a-hint">A lower number appears first.</span>
              </label>
            </div>

            <div class="a-acts">
              <button class="a-btn a-btn--primary" type="submit">
                <span set:html={ADMIN_ICONS.check} />
                Save
              </button>
            </div>
          </form>
        </div>

        <form method="POST" action="/api/admin/media" class="md__del">
          <input type="hidden" name="action" value="delete" />
          <input type="hidden" name="id" value={current.id} />
          <button class="a-btn a-btn--danger a-btn--sm" type="submit">Delete permanently</button>
        </form>
      </section>
    )}

    {/* ── Where the photographs go ────────────────────────────────── */}
    <section class="a-sec">
      <h2 class="a-sec__h">Where photos appear on the site</h2>

      <ul class="sl__grid">
        {SLOTS.map((sl) => {
          const held = bySlotKey.get(sl.key) ?? [];
          const usable = items.filter((m) => sl.kinds.includes(m.kind));
          return (
            <li class:list={['sl', { 'sl--just': justSaved === sl.key }]}>
              <div class="sl__frame" style={`--sl-ratio: ${sl.ratio}`}>
                {held.length ? (
                  held[0].kind === 'video' ? (
                    <video src={mediaUrl(held[0].key)} muted playsinline preload="metadata"></video>
                  ) : (
                    <img src={mediaUrl(held[0].key)} alt={held[0].alt_is ?? ''} loading="lazy" decoding="async" />
                  )
                ) : (
                  <span class="sl__empty">{sl.ratio}</span>
                )}
                {held.length > 1 && <span class="sl__count">+{held.length - 1}</span>}
              </div>

              <div class="sl__body">
                <p class="sl__name">{sl.label}</p>
                <p class="sl__where">{sl.where}</p>

                {held.length === 0 && sl.brief && <p class="sl__brief">{sl.brief}</p>}

                {held.length > 0 && !held[0].alt_is && (
                  <p class="sl__alert">Needs alt text before it is fair to publish.</p>
                )}

                <div class="sl__acts">
                  {usable.length > 0 && (
                    <details class="sl__pick">
                      <summary class="a-btn a-btn--quiet a-btn--sm">
                        {held.length ? (sl.multi ? 'Add another' : 'Replace') : 'Choose photo'}
                      </summary>
                      <div class="sl__panel">
                        <p class="sl__panelh">Tap a photo to put it here</p>
                        <ul class="sl__choices">
                          {usable.map((m) => (
                            <li>
                              <form method="POST" action="/api/admin/media">
                                <input type="hidden" name="action" value="assign" />
                                <input type="hidden" name="id" value={m.id} />
                                <input type="hidden" name="slot" value={sl.key} />
                                <button class="sl__choice" type="submit" title={m.alt_is ?? ''}>
                                  {m.kind === 'video' ? (
                                    <video src={mediaUrl(m.key)} muted playsinline preload="metadata"></video>
                                  ) : (
                                    <img src={mediaUrl(m.key)} alt="" loading="lazy" decoding="async" />
                                  )}
                                </button>
                              </form>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </details>
                  )}

                  {held.map((m) => (
                    <>
                      <a class="a-btn a-btn--plain a-btn--sm" href={`/admin/media/?edit=${m.id}`}>Edit</a>
                      <form method="POST" action="/api/admin/media">
                        <input type="hidden" name="action" value="unassign" />
                        <input type="hidden" name="id" value={m.id} />
                        <button class="a-btn a-btn--plain a-btn--sm" type="submit">Remove</button>
                      </form>
                    </>
                  ))}
                </div>
              </div>
            </li>
          );
        })}
      </ul>
    </section>

    {/* ── Everything uploaded ─────────────────────────────────────── */}
    <section class="a-sec">
      <h2 class="a-sec__h">
        Library
        {unplaced.length > 0 && <span class="a-sub"> · {unplaced.length} not used anywhere</span>}
      </h2>

      {items.length === 0 ? (
        <p class="a-empty">No photographs yet. Upload the first one above.</p>
      ) : (
        <ul class="md__grid">
          {items.filter((m, i, all) => all.findIndex((o) => o.key === m.key) === i).map((m) => {
            const where = placementsOf(m.key);
            return (
              <li>
                <a class="md__item" href={`/admin/media/?edit=${m.id}`}>
                  <span class="md__thumb">
                    {m.kind === 'video' ? (
                      <video src={mediaUrl(m.key)} muted playsinline preload="metadata"></video>
                    ) : (
                      <img src={mediaUrl(m.key)} alt={m.alt_is ?? ''} loading="lazy" decoding="async" />
                    )}
                    {m.kind === 'video' && <span class="md__vid">Video</span>}
                  </span>
                  <span class="md__where">
                    {where.length
                      ? where.map((w) => <span class="md__tag">{w}</span>)
                      : <span class="md__tag md__tag--none">Not used</span>}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      )}
    </section>
  </div>
</Admin>

<style>
  .md__up { margin-bottom: 18px; }

  /* A big target, because the common case is a thumb on a phone. */
  .md__drop {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 132px;
    padding: 18px;
    border: 1px dashed var(--a-line-2);
    border-radius: var(--a-r);
    background: var(--a-inset);
    text-align: center;
    cursor: pointer;
  }

  .md__drop:focus-within { border-color: var(--a-accent); box-shadow: 0 0 0 3px var(--a-accent-soft); }

  .md__file { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
  .md__dropicon { display: flex; width: 26px; height: 26px; color: var(--a-ink-3); }
  .md__dropicon :global(svg) { width: 100%; height: 100%; }
  .md__droptext { font-size: 15px; font-weight: 600; }
  .md__drophint { font-size: 12px; color: var(--a-ink-3); }

  /* ---- edit panel ---- */

  .md__edit { margin-bottom: 18px; display: flex; flex-direction: column; gap: 14px; }
  .md__editgrid { display: grid; grid-template-columns: 1fr; gap: 16px; }

  .md__preview img,
  .md__preview video {
    width: 100%;
    max-height: 300px;
    object-fit: contain;
    background: var(--a-sunken);
    border-radius: var(--a-r-sm);
    display: block;
  }

  .md__meta { margin-top: 6px; font-family: var(--a-mono); font-size: 11.5px; color: var(--a-ink-3); }
  .md__del { border-top: 1px solid var(--a-line); padding-top: 13px; }

  @media (min-width: 52rem) {
    .md__editgrid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); }
  }

  /* ---- library grid ---- */

  .md__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px;
  }

  @media (min-width: 40rem) { .md__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .md__grid { grid-template-columns: repeat(5, minmax(0, 1fr)); } }

  .md__item { display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: inherit; }

  .md__thumb {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    border-radius: var(--a-r-sm);
    overflow: hidden;
    background: var(--a-sunken);
    border: 1px solid var(--a-line);
  }

  .md__thumb img,
  .md__thumb video { width: 100%; height: 100%; object-fit: cover; display: block; }

  .md__vid {
    position: absolute;
    left: 6px; bottom: 6px;
    padding: 2px 7px;
    border-radius: var(--a-r-pill);
    background: rgba(20, 24, 28, .78);
    color: #fff;
    font-size: 10px;
    font-weight: 600;
  }

  /* ------------------------------------------------------------------ *
   * The slot grid — one card per frame the website can show.
   * ------------------------------------------------------------------ */

  .sl__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  @media (min-width: 40rem) { .sl__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 68rem) { .sl__grid { grid-template-columns: repeat(3, 1fr); } }

  .sl {
    display: flex;
    flex-direction: column;
    background: var(--a-surface);
    border: 1px solid var(--a-line);
    border-radius: 10px;
    overflow: hidden;
  }

  /* The slot just changed gets a ring, so a save is attached to a place
     rather than being a message at the top of a long page. */
  .sl--just { outline: 2px solid var(--a-accent); outline-offset: -2px; }

  .sl__frame {
    position: relative;
    aspect-ratio: var(--sl-ratio, 3 / 2);
    background:
      repeating-linear-gradient(135deg, rgba(20,24,28,.05) 0 1px, transparent 1px 9px),
      var(--a-inset);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sl__frame img,
  .sl__frame video { width: 100%; height: 100%; object-fit: cover; display: block; }

  .sl__empty { font-family: var(--a-mono); font-size: 12px; color: var(--a-ink-4); }

  .sl__count {
    position: absolute;
    right: 8px;
    bottom: 8px;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgba(20,24,28,.78);
    color: #fff;
    font-family: var(--a-mono);
    font-size: 11px;
  }

  .sl__body { display: flex; flex-direction: column; gap: 4px; padding: 12px; }
  .sl__name { font-weight: 600; font-size: 14.5px; color: var(--a-ink); }
  .sl__where { font-size: 12.5px; color: var(--a-ink-3); }

  .sl__brief {
    margin-top: 4px;
    font-size: 12.5px;
    line-height: 1.45;
    color: var(--a-ink-3);
  }

  .sl__alert { margin-top: 4px; font-size: 12.5px; color: var(--a-bad); }

  .sl__acts { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; align-items: center; }

  /* ---- the picker ---- */

  .sl__pick { position: relative; }
  .sl__pick summary { list-style: none; cursor: pointer; }
  .sl__pick summary::-webkit-details-marker { display: none; }
  .sl__pick summary::marker { content: ''; }

  .sl__panel {
    margin-top: 8px;
    padding: 10px;
    background: var(--a-inset);
    border: 1px solid var(--a-line);
    border-radius: 8px;
  }

  .sl__panelh {
    font-size: 12px;
    color: var(--a-ink-3);
    margin-bottom: 8px;
  }

  .sl__choices {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(64px, 1fr));
    gap: 6px;
    max-height: 240px;
    overflow-y: auto;
  }

  /* A whole-thumbnail button: the target is the picture, which is the thing
     somebody is actually aiming at. */
  .sl__choice {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
    border: 1px solid var(--a-line);
    border-radius: 6px;
    overflow: hidden;
    background: var(--a-sunken);
    cursor: pointer;
  }

  .sl__choice img,
  .sl__choice video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sl__choice:hover { border-color: var(--a-accent); }
  .sl__choice:focus-visible { outline: 2px solid var(--a-accent); outline-offset: 2px; }

  /* ---- library tags ---- */

  .md__where { display: flex; flex-wrap: wrap; gap: 4px; padding: 8px; }

  .md__tag {
    padding: 2px 7px;
    border-radius: 999px;
    background: var(--a-good-soft);
    color: var(--a-good);
    font-size: 11px;
    line-height: 1.5;
  }

  .md__tag--none { background: var(--a-sunken); color: var(--a-ink-3); }

  .md__warn { color: var(--a-bad); }
</style>
