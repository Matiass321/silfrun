---
import Admin from '~/layouts/Admin.astro';
import { env, resolvePasswordHash } from '~/lib/admin-guard';
import { SESSION_COOKIE, verifySession } from '~/lib/auth';

export const prerender = false;

const { DB, ADMIN_PASSWORD_HASH, ADMIN_SESSION_SECRET } = env(Astro);

/* Already signed in? Do not make them do it twice. */
if (ADMIN_SESSION_SECRET) {
  const token = Astro.cookies.get(SESSION_COOKIE)?.value;
  if (await verifySession(token, ADMIN_SESSION_SECRET)) return Astro.redirect('/admin/', 302);
}

/* With no password anywhere, a login form cannot succeed — offer setup. */
const hash = await resolvePasswordHash(DB, ADMIN_PASSWORD_HASH);
if (!hash) return Astro.redirect('/admin/setup/', 302);

const err = Astro.url.searchParams.get('e');
const MESSAGES: Record<string, string> = {
  bad: 'That email address or password is wrong.',
  rate: 'Too many attempts. Try again in a few minutes.',
  missing: 'Enter an email address and password.',
};
---

<Admin title="Sign-in" bare>
  <div class="lg">
    <svg class="lg__mark" viewBox="0 0 48 64" fill="none" aria-hidden="true">
      <path d="M24 2 Q16 17 6 32 Q16 47 24 62 Z" fill="currentColor" opacity=".12" />
      <path d="M24 2 Q32 17 42 32 Q32 47 24 62 Q16 47 6 32 Q16 17 24 2 Z"
            stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
    </svg>

    <h1 class="lg__h">Admin</h1>

    {!ADMIN_SESSION_SECRET && (
      <p class="a-msg a-msg--warn">ADMIN_SESSION_SECRET is not set. Sign-in will not work.</p>
    )}
    {err && MESSAGES[err] && <p class="a-msg a-msg--err">{MESSAGES[err]}</p>}

    <form class="a-form" method="POST" action="/api/admin/login">
      <label class="a-field">
        <span class="a-label">Email address</span>
        <input class="a-in" type="email" name="email" autocomplete="username" required autofocus />
      </label>

      <label class="a-field">
        <span class="a-label">Password</span>
        <input class="a-in" type="password" name="password" autocomplete="current-password" required />
      </label>

      <button class="a-btn a-btn--primary a-btn--block" type="submit">Sign in</button>
    </form>

    <p class="lg__note">The session lasts 12 hours.</p>
  </div>
</Admin>

<style>
  .lg { width: 100%; max-width: 340px; display: flex; flex-direction: column; gap: 14px; }
  .lg__mark { width: 34px; height: 45px; color: var(--a-ink-3); align-self: center; }
  .lg__h { font-size: 20px; font-weight: 600; text-align: center; letter-spacing: .04em; text-transform: uppercase; }
  .lg__note { font-size: 12.5px; color: var(--a-ink-4); text-align: center; }
</style>
