---
import Admin from '~/layouts/Admin.astro';
import { requireAdmin, env } from '~/lib/admin-guard';
import { visitsBetween, parseItems, formatPhone, type VisitRow } from '~/lib/visits';
import { today, startOfDay, isoDate, clock, longDate } from '~/lib/time';
import { ADMIN_ICONS } from '~/data/admin-icons';

export const prerender = false;

const gate = await requireAdmin(Astro);
if (gate) return gate;

const { DB } = env(Astro);

/* ?m=YYYY-MM selects the month; ?d=YYYY-MM-DD opens one day beneath it. */
const todayIso = today();
const monthRaw = Astro.url.searchParams.get('m') ?? todayIso.slice(0, 7);
const month = /^\d{4}-\d{2}$/.test(monthRaw) ? monthRaw : todayIso.slice(0, 7);
const selected = Astro.url.searchParams.get('d');

const [Y, M] = month.split('-').map(Number);

/**
 * The grid always starts on a Monday.
 *
 * getUTCDay() is 0 for Sunday, so the offset is shifted by one: an Icelandic
 * calendar begins the week on Monday, and a grid that starts on Sunday reads
 * as wrong to everyone who will use this.
 */
const first = new Date(Date.UTC(Y!, M! - 1, 1));
const lead = (first.getUTCDay() + 6) % 7;
const gridStart = new Date(Date.UTC(Y!, M! - 1, 1 - lead));

const CELLS = 42; // six weeks, so the grid never changes height month to month
const gridStartIso = isoDate(Math.floor(gridStart.getTime() / 1000));

let rows: VisitRow[] = [];
let dbError: string | null = null;

if (!DB) {
  dbError = 'Gagnagrunnurinn er ekki tengdur.';
} else {
  try {
    const from = startOfDay(gridStartIso);
    rows = await visitsBetween(DB, from, from + CELLS * 86400);
  } catch (e) {
    dbError = `Gagnagrunnurinn svarar ekki. (${String(e).slice(0, 100)})`;
  }
}

/** Bucket by local day so each cell is one lookup rather than a filter. */
const byDay = new Map<string, VisitRow[]>();
for (const r of rows) {
  if (!r.scheduled_at) continue;
  const d = isoDate(r.scheduled_at);
  if (!byDay.has(d)) byDay.set(d, []);
  byDay.get(d)!.push(r);
}

const cells = Array.from({ length: CELLS }, (_, i) => {
  const iso = isoDate(Math.floor(gridStart.getTime() / 1000) + i * 86400);
  return {
    iso,
    dayNum: Number(iso.slice(8, 10)),
    inMonth: iso.slice(0, 7) === month,
    isToday: iso === todayIso,
    isSelected: iso === selected,
    visits: byDay.get(iso) ?? [],
  };
});

const prevMonth = M === 1 ? `${Y! - 1}-12` : `${Y}-${String(M! - 1).padStart(2, '0')}`;
const nextMonth = M === 12 ? `${Y! + 1}-01` : `${Y}-${String(M! + 1).padStart(2, '0')}`;

const MONTHS = ['janúar','febrúar','mars','apríl','maí','júní','júlí','ágúst','september','október','nóvember','desember'];
const DOW = ['M', 'Þ', 'M', 'F', 'F', 'L', 'S'];

const dayVisits = selected ? (byDay.get(selected) ?? []) : [];
const monthTotal = cells.filter((c) => c.inMonth).reduce((n, c) => n + c.visits.length, 0);

const ITEM: Record<string, string> = {
  sofa: 'Sófi', rug: 'Teppi', carpet: 'Gólfteppi', stains: 'Blettir',
};
---

<Admin title="Dagatal" current="calendar">
  <div class="a-wrap">
    <header class="a-head">
      <div>
        <h1 class="a-h1">{MONTHS[M! - 1]} {Y}</h1>
        <p class="a-sub">{monthTotal} bókanir í mánuðinum</p>
      </div>
      <a class="a-btn a-btn--primary" href="/admin/new-visit/">
        <span set:html={ADMIN_ICONS.plus} />
        Nýtt
      </a>
    </header>

    {dbError && <p class="a-msg a-msg--err">{dbError}</p>}

    <nav class="cal__nav" aria-label="Mánuður">
      <a class="a-btn a-btn--plain a-btn--sm" href={`/admin/calendar/?m=${prevMonth}`} aria-label="Fyrri mánuður">
        <span set:html={ADMIN_ICONS.back} />
      </a>
      <a class="a-btn a-btn--plain a-btn--sm" href="/admin/calendar/">Í dag</a>
      <a class="a-btn a-btn--plain a-btn--sm cal__next" href={`/admin/calendar/?m=${nextMonth}`} aria-label="Næsti mánuður">
        <span set:html={ADMIN_ICONS.back} />
      </a>
    </nav>

    <div class="a-card cal">
      <div class="cal__dow" aria-hidden="true">
        {DOW.map((d) => <span>{d}</span>)}
      </div>

      <div class="cal__grid">
        {cells.map((c) => (
          <a
            class:list={['cal__cell', {
              'cal__cell--out': !c.inMonth,
              'cal__cell--today': c.isToday,
              'cal__cell--on': c.isSelected,
              'cal__cell--has': c.visits.length > 0,
            }]}
            href={`/admin/calendar/?m=${month}&d=${c.iso}`}
            aria-label={`${c.iso}, ${c.visits.length} bókanir`}
            aria-current={c.isToday ? 'date' : undefined}
          >
            <span class="cal__n">{c.dayNum}</span>
            {c.visits.length > 0 && (
              <span class="cal__dots">
                {c.visits.slice(0, 3).map(() => <span class="cal__dot"></span>)}
                {c.visits.length > 3 && <span class="cal__more">+{c.visits.length - 3}</span>}
              </span>
            )}
          </a>
        ))}
      </div>
    </div>

    {selected && (
      <section class="a-sec">
        <h2 class="a-sec__h">
          {longDate(selected, 'is')}
          {dayVisits.length > 0 && <span class="a-badge">{dayVisits.length}</span>}
        </h2>

        {dayVisits.length === 0 ? (
          <p class="a-empty">Ekkert bókað þennan dag.</p>
        ) : (
          <ul class="a-rows">
            {dayVisits.map((r) => {
              const digits = r.phone.replace(/[^0-9]/g, '');
              return (
                <li class="a-row">
                  <a class="cal__hit" href={`/admin/visits/?ref=${r.ref}`}>
                    <div class="a-row__top">
                      <span class="a-row__name">
                        <span class="cal__time">{clock(r.scheduled_at!)}</span>
                        {r.name}
                      </span>
                    </div>
                    <p class="a-row__meta">
                      {parseItems(r.items).map((i) => ITEM[i] ?? i).join(', ') || '—'}
                      {r.area ? ` · ${r.area}` : ''}
                    </p>
                    {r.address && <p class="a-row__mono">{r.address}</p>}
                  </a>
                  <div class="a-row__foot">
                    <a class="a-btn a-btn--plain a-btn--sm" href={`tel:${r.phone}`}>
                      <span set:html={ADMIN_ICONS.phone} />
                      {formatPhone(r.phone)}
                    </a>
                    <a class="a-btn a-btn--plain a-btn--sm" href={`https://wa.me/${digits}`} target="_blank" rel="noopener">
                      <span set:html={ADMIN_ICONS.whatsapp} />
                      WhatsApp
                    </a>
                  </div>
                </li>
              );
            })}
          </ul>
        )}
      </section>
    )}

    <p class="cal__sync">
      <span set:html={ADMIN_ICONS.link} />
      Til að sjá þetta í Google Calendar, sæktu áskriftarslóðina í
      <a href="/admin/settings/">Stillingum</a>.
    </p>
  </div>
</Admin>

<style>
  .cal__nav { display: flex; gap: 8px; margin-bottom: 12px; align-items: center; }
  .cal__next :global(svg) { transform: rotate(180deg); }

  .cal { padding: 10px; }

  .cal__dow,
  .cal__grid { display: grid; grid-template-columns: repeat(7, 1fr); }

  .cal__dow {
    gap: 2px;
    margin-bottom: 4px;
  }

  .cal__dow span {
    text-align: center;
    font-size: 11px;
    font-weight: 600;
    color: var(--a-ink-4);
    padding: 4px 0;
  }

  .cal__grid { gap: 2px; }

  .cal__cell {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 3px;
    /* Square-ish cells that stay tappable at 44px on the narrowest phone. */
    min-height: 46px;
    padding: 5px 2px 4px;
    border-radius: var(--a-r-sm);
    text-decoration: none;
    color: var(--a-ink);
    background: transparent;
    border: 1px solid transparent;
  }

  .cal__cell:active { background: var(--a-inset); }
  .cal__cell--out { color: var(--a-ink-4); }
  .cal__cell--has { background: var(--a-inset); }

  .cal__cell--today { border-color: var(--a-accent); font-weight: 700; }
  .cal__cell--today .cal__n { color: var(--a-accent); }

  .cal__cell--on { background: var(--a-accent); }
  .cal__cell--on .cal__n,
  .cal__cell--on .cal__more { color: var(--a-accent-ink); }
  .cal__cell--on .cal__dot { background: var(--a-accent-ink); }

  .cal__n { font-size: 14px; font-variant-numeric: tabular-nums; line-height: 1.2; }

  .cal__dots { display: flex; align-items: center; gap: 2px; }
  .cal__dot { width: 4px; height: 4px; border-radius: 50%; background: var(--a-accent); }
  .cal__more { font-size: 9px; color: var(--a-ink-3); font-family: var(--a-mono); }

  .cal__hit { display: block; text-decoration: none; color: inherit; }
  .cal__time {
    font-family: var(--a-mono);
    font-size: 13px;
    color: var(--a-accent);
    margin-right: 7px;
  }

  .cal__sync {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 22px;
    font-size: 12.5px;
    color: var(--a-ink-3);
    line-height: 1.5;
  }

  .cal__sync :global(svg) { width: 15px; height: 15px; flex: none; }
  .cal__sync a { color: var(--a-accent); }

  @media (min-width: 46rem) {
    .cal__cell { min-height: 74px; padding: 7px 4px; }
    .cal__n { font-size: 15px; }
  }
</style>
