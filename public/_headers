/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

  # The site is indexable. The X-Robots-Tag noindex that used to sit here has
  # been removed deliberately — note that robots.txt alone would not have
  # lifted it, which is why both had to change together.
  #
  # One consequence worth knowing: the *.pages.dev preview domain is indexable
  # too, and serves the same content as silfrun.com. It is not a ranking
  # problem — every page canonicalises to silfrun.com, so the preview host
  # consolidates into it rather than competing with it.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Generated fresh on every build from the route table and site config.
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/og.png
  Cache-Control: public, max-age=604800
